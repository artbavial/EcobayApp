@using EcobayApp.Services
@inject AdminAuthService AdminAuth
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="table-responsive req-dashboard-table-wrap">
    <table class="table table-hover align-middle admin-table req-dashboard-table">
        <thead>
            <tr><th>Дата</th><th>Статус</th><th>Клиент</th><th>Телефон</th><th>Сообщение</th><th>Город</th><th>Связь и действия</th>
                @if (CanShowDelete) { <th><span class="visually-hidden">Действия</span></th> }
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Rows)
            {
                <tr @key="row.Id">
                    <td data-label="Дата">@row.Date.ToString("dd.MM.yyyy HH:mm")</td>
                    <td data-label="Статус"><span class="req-status req-status-@row.Status.ToString().ToLowerInvariant()">@RequestWorkflow.StatusTitle(row.Status)</span></td>
                    <td data-label="Клиент">@row.Name</td>
                    <td data-label="Телефон"><a href="@($"tel:{row.Phone}")">@row.Phone</a></td>
                    <td data-label="Описание" class="admin-request-message">@row.Message</td>
                    <td data-label="Город">@row.City</td>
                    <td data-label="Связь и действия" class="req-table-contact">
                        <RequestCallButton Row="row" OnChanged="OnChanged" />
                        @if (OnEdit.HasDelegate) { <button type="button" class="btn btn-outline-secondary btn-sm mt-2" @onclick="() => OnEdit.InvokeAsync(row.Id)">Изменить</button> }
                        @if (row.WeightKg.HasValue) { <small class="d-block mt-2">Вес: @row.WeightKg.Value.ToString("N2") кг</small> }
                    </td>
                    @if (CanShowDelete)
                    {
                        <td data-label="Удаление"><button type="button" class="btn btn-sm btn-outline-danger"
                                    disabled="@(Busy || deleting)" @onclick="() => DeleteRowAsync(row.Id)">Удалить</button></td>
                    }
                </tr>
            }
            @if (Rows.Count == 0)
            {
                <tr><td colspan="@(CanShowDelete ? 8 : 7)" class="text-center py-4 admin-muted">Заявок за выбранный период нет.</td></tr>
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter] public IReadOnlyList<AdminRequestRow> Rows { get; set; } = Array.Empty<AdminRequestRow>();
    [Parameter] public bool AllowDelete { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<long> OnDelete { get; set; }
    [Parameter] public EventCallback<long> OnEdit { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    private bool canDeleteRequests;
    private bool CanShowDelete => AllowDelete && canDeleteRequests;
    private bool deleting;

    protected override async Task OnInitializedAsync()
    {
        canDeleteRequests = await AdminAuth.CanDeleteRequestsAsync(
            (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User);
    }

    private async Task DeleteRowAsync(long id)
    {
        if (Busy || deleting || !AllowDelete) return;
        deleting = true;
        try
        {
            canDeleteRequests = await AdminAuth.CanDeleteRequestsAsync(
                (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User);
            if (!canDeleteRequests) return;
            await OnDelete.InvokeAsync(id);
        }
        finally { deleting = false; }
    }
}
