@using EcobayApp.Services
@inject AdminAuthService AdminAuth
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="table-responsive">
    <table class="table table-hover align-middle admin-table">
        <thead>
            <tr><th>Дата</th><th>Статус</th><th>Клиент</th><th>Телефон</th><th>Сообщение</th><th>Город</th>
                @if (CanShowDelete) { <th><span class="visually-hidden">Действия</span></th> }
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Rows)
            {
                <tr @key="row.Id">
                    <td class="text-nowrap">@row.Date.ToString("dd.MM.yyyy HH:mm")</td>
                    <td><span class="req-status req-status-@row.Status.ToString().ToLowerInvariant()">@RequestWorkflow.StatusTitle(row.Status)</span></td>
                    <td>@row.Name</td>
                    <td class="text-nowrap"><a href="@($"tel:{row.Phone}")">@row.Phone</a></td>
                    <td class="admin-request-message">@row.Message</td>
                    <td>@row.City</td>
                    @if (CanShowDelete)
                    {
                        <td><button type="button" class="btn btn-sm btn-outline-danger"
                                    disabled="@(Busy || deleting)" @onclick="() => DeleteRowAsync(row.Id)">Удалить</button></td>
                    }
                </tr>
            }
            @if (Rows.Count == 0)
            {
                <tr><td colspan="@(CanShowDelete ? 7 : 6)" class="text-center py-4 admin-muted">Заявок за выбранный период нет.</td></tr>
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter] public IReadOnlyList<AdminRequestRow> Rows { get; set; } = Array.Empty<AdminRequestRow>();
    [Parameter] public bool AllowDelete { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<long> OnDelete { get; set; }
    private bool canDeleteRequests;
    private bool CanShowDelete => AllowDelete && canDeleteRequests;
    private bool deleting;

    protected override async Task OnInitializedAsync()
    {
        canDeleteRequests = await AdminAuth.CanDeleteRequestsAsync(
            (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User);
    }

    private async Task DeleteRowAsync(long id)
    {
        if (Busy || deleting || !AllowDelete) return;
        deleting = true;
        try
        {
            canDeleteRequests = await AdminAuth.CanDeleteRequestsAsync(
                (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User);
            if (!canDeleteRequests) return;
            await OnDelete.InvokeAsync(id);
        }
        finally { deleting = false; }
    }
}
