@using EcobayApp.Contex
@using EcobayApp.Models
@using EcobayApp.Services
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDBContext> DbFactory
@inject ILogger<AdminGoals> Logger
@inject SitePermissions Permissions

<div class="admin-card">
    <h2 class="admin-card-title">Цели и прогресс</h2>
    @if (!isFullAdmin) { <p class="admin-hint">Можно изменить плановые показатели. Факт, ручная добавка, активация и автодобавка доступны только администратору.</p> }
    <div class="d-flex gap-2 align-items-end mb-3">
        <div><label class="admin-label" for="goalsYear">Год</label>
            <input class="form-control" id="goalsYear" type="number" min="2020" max="2100" @bind="selectedYear" disabled="@busy" /></div>
        <button class="btn btn-outline-secondary" disabled="@busy" @onclick="LoadAsync">Загрузить</button>
    </div>
    @if (error is not null) { <div class="admin-alert admin-alert-error mb-3" role="alert">@error</div> }
    @if (message is not null) { <div class="admin-alert admin-alert-ok mb-3" role="status">@message</div> }
    @if (edit is not null)
    {
        <h3 class="admin-card-title">@(edit.Id == 0 ? "Новая цель" : "Редактирование цели") на @edit.Year год</h3>
        <div class="row g-3">
            <div class="col-lg-7">
                <div class="row g-3">
                    <div class="col-sm-6"><label class="admin-label" for="targetClients">Цель: клиентов</label>
                        <input class="form-control" id="targetClients" type="number" min="1" max="1000000000" @bind="edit.TargetClients" disabled="@busy" /></div>
                    <div class="col-sm-6"><label class="admin-label" for="targetItems">Цель: единиц техники</label>
                        <input class="form-control" id="targetItems" type="number" min="1" max="1000000000" @bind="edit.TargetItems" disabled="@busy" /></div>
                    <div class="col-sm-6"><label class="admin-label" for="actualClients">Фактически: клиентов</label>
                        <input class="form-control" id="actualClients" type="number" min="0" max="1000000000" @bind="edit.ActualClients" disabled="@(busy || !isFullAdmin)" /></div>
                    <div class="col-sm-6"><label class="admin-label" for="actualItems">Фактически: единиц техники</label>
                        <input class="form-control" id="actualItems" type="number" min="0" max="1000000000" @bind="edit.ActualItems" disabled="@(busy || !isFullAdmin)" /></div>
                    <div class="col-sm-6"><label class="admin-label" for="inactiveRequests">Ручная добавка к прогрессу</label>
                        <input class="form-control" id="inactiveRequests" type="number" min="0" max="1000000000" @bind="edit.InactiveRequests" disabled="@(busy || !isFullAdmin)" />
                        <small class="admin-muted">Поле БД InactiveRequests. Это количество, не процент.</small></div>
                    <div class="col-sm-6"><label class="admin-label" for="goalStart">Дата начала</label>
                        <input class="form-control" id="goalStart" type="date" @bind="edit.StartDate" disabled="@(busy || !isFullAdmin)" /></div>
                </div>
                <div class="form-check form-switch my-3">
                    <input class="form-check-input" id="goalActive" type="checkbox" @bind="edit.IsActive" disabled="@(busy || !isFullAdmin)" />
                    <label class="form-check-label" for="goalActive">Активная цель этого года</label>
                </div>
                <button class="admin-btn admin-btn-primary" disabled="@(busy || (!isFullAdmin && edit.Id == 0))" @onclick="SaveAsync">@(busy ? "Сохранение..." : (isFullAdmin ? "Сохранить цели и прогресс" : "Сохранить план"))</button>
            </div>
            <div class="col-lg-5">
                <div class="admin-hint">
                    <h3 class="admin-card-title">Предпросмотр</h3>
                    <p>Клиенты: @edit.ActualClients + @edit.InactiveRequests = <strong>@AdminReporting.Completed(edit)</strong> из @edit.TargetClients.</p>
                    <p>Выполнение: <strong>@ClientPercent.ToString("0.#")%</strong></p>
                    <div class="admin-progress"><span style="@Width(ClientPercent)"></span></div>
                    <p class="mt-3">Техника: @edit.ActualItems из @edit.TargetItems, <strong>@ItemPercent.ToString("0.#")%</strong>.</p>
                    <div class="admin-progress"><span style="@Width(ItemPercent)"></span></div>
                    <p class="admin-muted mt-3 mb-0">
                        После сохранения эти значения увидят дашборд и новые открытия сайта.
                        Новые заявки по-прежнему автоматически добавляют по 1 к факту клиентов и техники.
                        Ручная добавка не создаёт заявки и не меняет статистику по городам.
                    </p>
                </div>
            </div>
        </div>
    }
</div>

@if (isFullAdmin && edit is not null && edit.Id != 0)
{
    <div class="admin-card mt-3">
        <h2 class="admin-card-title">Автодобавка каждый час</h2>
        <p class="admin-muted">
            Сервер сам раз в час прибавляет указанное количество к «ручной добавке» (InactiveRequests) активной цели.
            Если сервер или пул IIS был остановлен, пропущенные часы досчитаются при следующем запуске (не более чем за 30 дней).
        </p>
        @if (autoError is not null) { <div class="admin-alert admin-alert-error mb-3" role="alert">@autoError</div> }
        @if (autoMessage is not null) { <div class="admin-alert admin-alert-ok mb-3" role="status">@autoMessage</div> }
        <div class="form-check form-switch mb-3 admin-switch">
            <input class="form-check-input" id="autoEnabled" type="checkbox" @bind="autoEnabled" disabled="@busy" />
            <label class="form-check-label" for="autoEnabled">Включить автодобавку</label>
        </div>
        <div class="row g-3">
            <div class="col-sm-4">
                <label class="admin-label" for="autoPer">Добавлять за час</label>
                <input class="form-control" id="autoPer" type="number" min="1" max="1000" @bind="autoPer" disabled="@busy" />
            </div>
            <div class="col-sm-4">
                <label class="admin-label" for="autoFrom">С часа (включительно)</label>
                <input class="form-control" id="autoFrom" type="number" min="0" max="23" @bind="autoFrom" disabled="@busy" />
            </div>
            <div class="col-sm-4">
                <label class="admin-label" for="autoTo">По час (включительно)</label>
                <input class="form-control" id="autoTo" type="number" min="0" max="23" @bind="autoTo" disabled="@busy" />
            </div>
        </div>
        <p class="admin-muted mt-2 mb-3">
            Это примерно <strong>+@AutoPerDay в день</strong> (@HoursPerDay начислений по @autoPer).
            @if (edit.AutoIncrementEnabled && edit.AutoIncrementLastAt.HasValue)
            {
                <span>Последнее учтённое время: @edit.AutoIncrementLastAt.Value.ToString("dd.MM.yyyy HH:mm").</span>
            }
        </p>
        <button class="admin-btn admin-btn-primary" disabled="@busy" @onclick="SaveAutoAsync">Сохранить автодобавку</button>
        @if (!edit.IsActive) { <p class="admin-muted mt-2 mb-0">Цель неактивна — автодобавка для неё работать не будет.</p> }
    </div>
}

@code {
    private int selectedYear = DateTime.Today.Year;
    private Goal? edit, original;
    private bool busy;
    private bool isFullAdmin;
    private string? error, message;
    private decimal ClientPercent => edit is null ? 0 : AdminReporting.Percent(AdminReporting.Completed(edit), edit.TargetClients);
    private decimal ItemPercent => edit is null ? 0 : AdminReporting.Percent(edit.ActualItems, edit.TargetItems);
    private static string Width(decimal n) => $"width:{Math.Clamp(n, 0, 100).ToString(System.Globalization.CultureInfo.InvariantCulture)}%";

    private bool autoEnabled;
    private int autoPer = 1, autoFrom = 8, autoTo = 21;
    private string? autoError, autoMessage;
    private int HoursPerDay => Math.Clamp(autoFrom, 0, 23) <= Math.Clamp(autoTo, 0, 23)
        ? Math.Clamp(autoTo, 0, 23) - Math.Clamp(autoFrom, 0, 23) + 1
        : 24 - Math.Clamp(autoFrom, 0, 23) + Math.Clamp(autoTo, 0, 23) + 1;
    private int AutoPerDay => HoursPerDay * Math.Max(0, autoPer);

    private void FillAuto()
    {
        if (edit is null) return;
        autoEnabled = edit.AutoIncrementEnabled;
        autoPer = edit.AutoIncrementPerHour <= 0 ? 1 : edit.AutoIncrementPerHour;
        autoFrom = edit.AutoIncrementFromHour;
        autoTo = edit.AutoIncrementToHour;
    }

    private async Task SaveAutoAsync()
    {
        if (busy || edit is null || edit.Id == 0) return;
        autoError = autoMessage = null;
        if (autoPer is < 1 or > 1000) { autoError = "Количество за час: от 1 до 1000."; return; }
        if (autoFrom is < 0 or > 23 || autoTo is < 0 or > 23) { autoError = "Часы указываются от 0 до 23."; return; }
        busy = true;
        try
        {
            await Permissions.RequireAdminAsync();
            await using var db = await DbFactory.CreateDbContextAsync();
            var now = DateTime.Now;
            var hourStart = new DateTime(now.Year, now.Month, now.Day, now.Hour, 0, 0);
            var wasEnabled = edit.AutoIncrementEnabled;
            // При включении начинаем отсчёт с текущего часа — без начислений «задним числом».
            DateTime? lastAt = autoEnabled ? (wasEnabled ? edit.AutoIncrementLastAt ?? hourStart : hourStart) : null;
            await db.Goals.Where(g => g.Id == edit.Id).ExecuteUpdateAsync(u => u
                .SetProperty(g => g.AutoIncrementEnabled, autoEnabled)
                .SetProperty(g => g.AutoIncrementPerHour, autoPer)
                .SetProperty(g => g.AutoIncrementFromHour, autoFrom)
                .SetProperty(g => g.AutoIncrementToHour, autoTo)
                .SetProperty(g => g.AutoIncrementLastAt, lastAt));
            edit.AutoIncrementEnabled = autoEnabled;
            edit.AutoIncrementPerHour = autoPer;
            edit.AutoIncrementFromHour = autoFrom;
            edit.AutoIncrementToHour = autoTo;
            edit.AutoIncrementLastAt = lastAt;
            autoMessage = autoEnabled
                ? $"Автодобавка включена: +{autoPer} каждый час с {autoFrom}:00 по {autoTo}:00."
                : "Автодобавка выключена.";
        }
        catch (Exception ex) { Logger.LogError(ex, "Cannot save auto increment"); autoError = "Не удалось сохранить настройки."; }
        finally { busy = false; }
    }

    protected override async Task OnInitializedAsync()
    {
        isFullAdmin = (await Permissions.RequireStaffAsync()).Role == AdminRoles.Admin;
        await LoadAsync();
    }
    private async Task LoadAsync()
    {
        if (busy) return;
        error = message = null;
        if (selectedYear is < 2020 or > 2100) { error = "Укажите год от 2020 до 2100."; return; }
        busy = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            edit = await db.Goals.AsNoTracking().Where(g => g.Year == selectedYear)
                .OrderByDescending(g => g.IsActive).ThenByDescending(g => g.StartDate).ThenByDescending(g => g.Id)
                .FirstOrDefaultAsync();
            original = edit is null ? null : Clone(edit);
            autoError = autoMessage = null;
            edit ??= new Goal { Year = selectedYear, StartDate = new DateTime(selectedYear, 1, 1), TargetClients = 5000, TargetItems = 12000 };
            FillAuto();
        }
        catch (Exception ex) { Logger.LogError(ex, "Cannot load goal"); error = "Не удалось загрузить цели."; }
        finally { busy = false; }
    }

    private async Task SaveAsync()
    {
        if (busy || edit is null) return;
        error = message = null;
        if (selectedYear != edit.Year) { error = "Год изменён. Сначала нажмите «Загрузить»."; return; }
        if (edit.TargetClients is < 1 or > 1000000000 || edit.TargetItems is < 1 or > 1000000000 ||
            edit.ActualClients is < 0 or > 1000000000 || edit.ActualItems is < 0 or > 1000000000 ||
            edit.InactiveRequests is < 0 or > 1000000000)
        { error = "Цели должны быть больше нуля, фактические значения и добавка неотрицательные. Максимум: 1 000 000 000."; return; }
        if (edit.StartDate.Year != edit.Year) { error = "Дата начала должна относиться к выбранному году."; return; }
        busy = true;
        try
        {
            var actor = await Permissions.RequireStaffAsync();
            await using var db = await DbFactory.CreateDbContextAsync();
            if (actor.Role == AdminRoles.Manager)
            {
                if (edit.Id == 0) { error = "Создание цели доступно администратору. Руководитель изменяет план существующей цели."; return; }
                var oldPlan = original;
                if (oldPlan is null) { error = "Сначала загрузите цель."; return; }
                var changed = await db.Goals.Where(g => g.Id == oldPlan.Id && g.Year == oldPlan.Year &&
                        g.TargetClients == oldPlan.TargetClients && g.TargetItems == oldPlan.TargetItems)
                    .ExecuteUpdateAsync(u => u.SetProperty(g => g.TargetClients, edit.TargetClients)
                        .SetProperty(g => g.TargetItems, edit.TargetItems));
                if (changed == 0) { error = "План изменился в другой сессии. Загрузите данные повторно."; return; }
                var fresh = await db.Goals.AsNoTracking().SingleAsync(g => g.Id == edit.Id);
                edit = fresh; original = Clone(fresh); FillAuto();
                message = "Плановые показатели сохранены. Факт и настройки прогресса не изменены.";
                return;
            }

            await using var transaction = await db.Database.BeginTransactionAsync(System.Data.IsolationLevel.Serializable);
            if (edit.Id == 0)
            {
                if (await db.Goals.AnyAsync(g => g.Year == edit.Year))
                { error = "Цель уже создана в другой сессии. Нажмите «Загрузить»."; return; }
                db.Goals.Add(edit);
                await db.SaveChangesAsync();
            }
            else
            {
                var old = original!;
                // Optimistic comparison protects increments made by new requests while the editor was open.
                var count = await db.Goals.Where(g => g.Id == old.Id && g.Year == old.Year &&
                        g.ActualClients == old.ActualClients && g.ActualItems == old.ActualItems &&
                        g.InactiveRequests == old.InactiveRequests && g.TargetClients == old.TargetClients &&
                        g.TargetItems == old.TargetItems && g.IsActive == old.IsActive && g.StartDate == old.StartDate)
                    .ExecuteUpdateAsync(s => s
                        .SetProperty(g => g.TargetClients, edit.TargetClients)
                        .SetProperty(g => g.TargetItems, edit.TargetItems)
                        .SetProperty(g => g.ActualClients, edit.ActualClients)
                        .SetProperty(g => g.ActualItems, edit.ActualItems)
                        .SetProperty(g => g.InactiveRequests, edit.InactiveRequests)
                        .SetProperty(g => g.StartDate, edit.StartDate)
                        .SetProperty(g => g.IsActive, edit.IsActive));
                if (count == 0) { error = "Данные изменились: пришла новая заявка или сработала автодобавка. Нажмите «Загрузить» и повторите правку."; return; }
            }
            if (edit.IsActive)
                await db.Goals.Where(g => g.Year == edit.Year && g.Id != edit.Id && g.IsActive)
                    .ExecuteUpdateAsync(s => s.SetProperty(g => g.IsActive, false));
            await transaction.CommitAsync();
            original = Clone(edit);
            message = "Цели и прогресс сохранены.";
        }
        catch (Exception ex) { Logger.LogError(ex, "Cannot save goal"); error = "Не удалось сохранить. Обновите данные и повторите попытку."; }
        finally { busy = false; }
    }

    private static Goal Clone(Goal g) => new()
    {
        Id = g.Id, Year = g.Year, TargetClients = g.TargetClients, TargetItems = g.TargetItems,
        ActualClients = g.ActualClients, ActualItems = g.ActualItems, InactiveRequests = g.InactiveRequests,
        StartDate = g.StartDate, IsActive = g.IsActive,
        AutoIncrementEnabled = g.AutoIncrementEnabled, AutoIncrementPerHour = g.AutoIncrementPerHour,
        AutoIncrementFromHour = g.AutoIncrementFromHour, AutoIncrementToHour = g.AutoIncrementToHour,
        AutoIncrementLastAt = g.AutoIncrementLastAt
    };
}
