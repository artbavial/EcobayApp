@using EcobayApp.Contex
@using EcobayApp.Services
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDBContext> DbFactory
@inject SitePermissions Permissions

<section class="admin-card mb-3" style="height:auto">
    <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap">
        <h2 class="admin-card-title mb-0">Уведомления о заявках</h2>
        <button type="button" class="btn btn-outline-secondary" disabled="@busy" @onclick="LoadAsync" aria-label="Обновить очередь писем"><i class="fa-solid fa-rotate" aria-hidden="true"></i></button>
    </div>
    @if (error) { <p class="admin-status-error mt-2 mb-0">Не удалось загрузить состояние очереди.</p> }
    else { <p class="mt-3 mb-0">В очереди: <strong>@pending</strong> · Ожидают повтора после ошибки: <strong>@failed</strong></p> }
</section>
@code {
    [Parameter] public DateTime RefreshKey { get; set; }
    private DateTime lastKey;
    private int pending, failed;
    private bool busy, error;
    protected override async Task OnParametersSetAsync() { if (lastKey != RefreshKey) { lastKey = RefreshKey; await LoadAsync(); } }
    private async Task LoadAsync()
    {
        if (busy) return;
        busy = true; error = false;
        try {
            await Permissions.RequireStaffAsync();
            await using var db = await DbFactory.CreateDbContextAsync();
            pending = await db.RequestEmailOutbox.CountAsync(x => x.SentAtUtc == null);
            failed = await db.RequestEmailOutbox.CountAsync(x => x.SentAtUtc == null && x.LastError != null);
        } catch { error = true; } finally { busy = false; }
    }
}
