    private static string BuildHeroPriceText(decimal fromPrice, int? toKopeks, bool isDeliveryPriceMode)
    {
        var fromKopeks = (int)fromPrice;

        if (isDeliveryPriceMode && toKopeks.HasValue && toKopeks.Value > fromKopeks)
            return $"{fromKopeks}–{toKopeks.Value} копеек";

        if (toKopeks.HasValue && toKopeks.Value > fromKopeks)
            return $"от {fromKopeks} до {toKopeks.Value} копеек";

        return $"от {fromKopeks} копеек";
    }

