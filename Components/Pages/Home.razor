<FeedbackModal @bind-Visible="isFeedbackVisible" Cities="activeCities" DefaultCityId="currentCity?.Id" />

@if (isCitySelectorVisible)
{
    <div class="city-modal-overlay" role="dialog" aria-modal="true" aria-labelledby="cityModalTitle" @onclick="CloseCitySelectorAsync">
        <div class="city-modal" @onclick:stopPropagation="true">
            <button type="button" class="city-modal-close" aria-label="Закрыть" @onclick="CloseCitySelectorAsync">
                <i class="fa-solid fa-xmark"></i>
            </button>

            <div class="city-modal-icon"><i class="fa-solid fa-location-dot"></i></div>
            <h2 id="cityModalTitle" class="city-modal-title">
                @(string.IsNullOrWhiteSpace(mainPage.CitySelectorTitle) ? "Выберите ваш город" : mainPage.CitySelectorTitle)
            </h2>
            @if (!string.IsNullOrWhiteSpace(mainPage.CitySelectorText))
            {
                <p class="city-modal-text">@mainPage.CitySelectorText</p>
            }

            @if (activeCities.Count > 8)
            {
                <div class="city-modal-search">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <input type="text" placeholder="Поиск города" @bind="citySearch" @bind:event="oninput" />
                </div>
            }

            <div class="city-modal-list" role="radiogroup" aria-label="Город">
                @foreach (var c in FilteredSelectorCities)
                {
                    var isSelected = selectedSlug == c.Slug;
                    <button type="button" role="radio" aria-checked="@(isSelected ? "true" : "false")"
                            class="city-option @(isSelected ? "selected" : "")"
                            @onclick="() => selectedSlug = c.Slug"
                            @ondblclick="() => ConfirmCityAsync(c.Slug)">
                        <span class="city-option-radio"></span>
                        <span class="city-option-name">@c.Name</span>
                    </button>
                }
                @if (!FilteredSelectorCities.Any())
                {
                    <p class="city-modal-empty">Такого города нет в списке.</p>
                }
            </div>

            <button type="button" class="starta-button w-100 city-modal-confirm" disabled="@(selectedSlug is null)"
                    @onclick="() => ConfirmCityAsync(selectedSlug)">
                <span class="position-relative">@(selectedSlug is null ? "Выберите город" : $"Подтвердить: {SelectedCityName}")</span>
                <span class="starta-button-hover"></span>
            </button>

            <button type="button" class="city-modal-other" @onclick="ChooseAllBelarusAsync">
                Моего города нет: посмотреть зону обслуживания
            </button>
        </div>
    </div>
}

@if (isPromoVisible)
{
    <div class="promo-overlay" @onclick="ClosePromo">
        <div class="promo-modal" @onclick:stopPropagation="true">
            <h2 class="starta-h2 mb-3">@promoTitle</h2>
            <p class="starta-desc mb-3">@promoText</p>

            <button class="starta-button w-100" @onclick="ClosePromo">
                <span class="position-relative">Понятно</span>
                <span class="starta-button-hover"></span>
            </button>
        </div>
    </div>
}

@code
{
    #region Параметры маршрута и данные страницы

    [Parameter] public string? slug { get; set; }

    [SupplyParameterFromQuery(Name = "choose-city")] public string? ChooseCityQuery { get; set; }
    [SupplyParameterFromQuery(Name = "all")] public string? AllBelarusQuery { get; set; }

    private PageCity? pageCity;
    private City? currentCity;
    private bool isCityMode => pageCity != null;

    /// <summary>Активные города с сохранённой страницей — для окна выбора, футера и списка на первом экране.</summary>
    private List<City> activeCities = new();
    private bool isFeedbackVisible;
    private void OpenFeedback() => isFeedbackVisible = true;

    /// <summary>Настройки страницы «Вся Беларусь» (из панели управления).</summary>
    private MainPageSettings mainPage = DbSeeder.CreateDefaultMainPage();

    private PromoMessage? promo;
    private Goal? goal;

    private int? priceToKopeks;
    private string heroPriceText = "";

    #endregion

    #region Константы и текстовые данные

    private string? formErrorMessage;
    private string phone = "+375 (29) 991-06-66";
    private string thisYear = DateTime.Now.Year.ToString();
    private int ProgresPercent = 0;
    private int year = DateTime.Now.Year;
    private string Title = "Вывоз техники в наших городах и их районах";
    private const string DefaultPhone = DbSeeder.DefaultPhone;

    private string? HeroTextOverride =>
        !isCityMode && !string.IsNullOrWhiteSpace(mainPage.HeroText) ? mainPage.HeroText : null;

    private bool HasPriceRange => priceToKopeks.HasValue && priceToKopeks.Value > (int)price;

    private int ProgressClamped => Math.Clamp(ProgresPercent, 0, 100);

    private string CitiesInText
    {
        get
        {
            var names = activeCities.Select(c => c.NameIn).ToList();
            if (names.Count == 0) return "";
            if (names.Count == 1) return names[0];
            return string.Join(", ", names.Take(names.Count - 1)) + " и " + names[^1];
        }
    }

    private string FooterCitiesText => activeCities.Count > 0
        ? $"Приём бытовой техники только в {CitiesInText} и населённых пунктах районов этих городов."
        : "Зону обслуживания уточняйте по телефону.";

    private string MetaDescription
    {
        get
        {
            if (isCityMode && !string.IsNullOrWhiteSpace(pageCity!.Description)) return pageCity.Description!;
            if (!isCityMode && !string.IsNullOrWhiteSpace(mainPage.Description)) return mainPage.Description!;
            return activeCities.Count > 0
                ? $"Вывоз и утилизация бытовой техники в {CitiesInText}. Приедем, вынесем и заплатим на месте."
                : "Вывоз техники в обслуживаемых городах и их районах.";
        }
    }

    private string MetaKeywords =>
        (isCityMode ? pageCity!.KeyWords : mainPage.KeyWords)
        ?? "утилизация, техника, переработка, приём техники, утилизация электроники";

    private string CanonicalUrl => Nav.BaseUri.TrimEnd('/') + (isCityMode ? $"/{currentCity!.Slug}" : "/");

    #endregion

    #region Калькулятор выплаты

    private decimal price = 20m;
    private decimal weight = 500m;
    private decimal total;
    private string resultMessage = "";

    private bool isDeliveryMode;

    private bool IsDeliveryPriceModeActive =>
        isDeliveryMode &&
        priceToKopeks.HasValue &&
        priceToKopeks.Value > (int)price;

    private decimal CurrentFromPriceKopeks =>
        pageCity?.Price ?? currentCity?.DefaultPrice ?? price;

    private int? CurrentToPriceKopeks =>
        pageCity?.PriceToKopeks ?? priceToKopeks;

    private decimal DeliveryTotal =>
        weight > 0 ? weight * CurrentFromPriceKopeks / 100m : 0m;

    private decimal SelfDeliveryTotal =>
        weight > 0 && CurrentToPriceKopeks.HasValue
            ? weight * CurrentToPriceKopeks.Value / 100m
            : 0m;


    private string PageBaseUrl => string.IsNullOrWhiteSpace(slug) ? "/" : $"/{slug}";
    private string SectionUrl(string sectionId)
    {
        var baseUrl = string.IsNullOrWhiteSpace(slug) ? "/" : $"/{slug}";
        return $"{baseUrl}#{sectionId}";
    }

    private void Calculate()
    {
        if (weight <= 0)
        {
            resultMessage = "Введите корректный вес.";
            total = 0;
            return;
        }

        var fromPriceKopeks = CurrentFromPriceKopeks;
        var toPriceKopeksLocal = CurrentToPriceKopeks;

        var minTotal = weight * fromPriceKopeks / 100m;
        total = minTotal;

        if (IsDeliveryPriceModeActive)
        {
            resultMessage = string.Empty;
            return;
        }

        if (toPriceKopeksLocal.HasValue && toPriceKopeksLocal.Value > fromPriceKopeks)
        {
            var maxTotal = weight * toPriceKopeksLocal.Value / 100m;
            resultMessage =
                $"Вы получите <strong>от {minTotal:F2} до {maxTotal:F2} рублей</strong> за {weight:F1} кг техники.*";
        }
        else
        {
            resultMessage =
                $"Вы получите <strong>от {minTotal:F2} рублей</strong> за {weight:F1} кг техники.*";
        }
    }

    #endregion

    #region Показатели/цели

    private long totalClientsDisplay;
    private int totalItemsDisplay;
    private int progressPercentDisplay;

    #endregion

    #region Жизненный цикл компонента

    protected override async Task OnParametersSetAsync()
    {
        mainPage = await Db.MainPageSettings.AsNoTracking().OrderBy(m => m.Id).FirstOrDefaultAsync()
                   ?? DbSeeder.CreateDefaultMainPage();

        activeCities = await Db.Cities.AsNoTracking()
            .Where(c => c.IsActive && c.Pages.Any())
            .OrderBy(c => c.SortOrder).ThenBy(c => c.Name)
            .ToListAsync();

        pageCity = null;
        currentCity = null;
        promo = null;
        priceToKopeks = null;

        if (!string.IsNullOrWhiteSpace(slug))
        {
            var normalizedSlug = slug.Trim().ToLowerInvariant();
            pageCity = await Db.PageCities.AsNoTracking()
                .Include(p => p.City)
                .FirstOrDefaultAsync(p => p.City.Slug == normalizedSlug && p.City.IsActive);

            if (pageCity is null)
            {
                // Неизвестный или выключенный город — на общую страницу с окном выбора города.
                Nav.NavigateTo("/?choose-city=1", replace: true);
                return;
            }

            currentCity = pageCity.City;
        }

        if (pageCity != null && currentCity != null)
        {
            Title = !string.IsNullOrWhiteSpace(pageCity.Title)
                ? pageCity.Title
                : $"Вывоз бытовой техники в {currentCity.NameIn}";

            phone = pageCity.PhoneCity ?? currentCity.DefaultPhone ?? DefaultPhone;
            price = pageCity.Price ?? currentCity.DefaultPrice ?? 20m;
            priceToKopeks = pageCity.PriceToKopeks;
            isDeliveryMode = pageCity.IsDeliveryPriceMode;
        }
        else
        {
            Title = string.IsNullOrWhiteSpace(mainPage.Title) ? "Вывоз техники в наших городах и их районах" : mainPage.Title;
            phone = string.IsNullOrWhiteSpace(mainPage.Phone) ? DefaultPhone : mainPage.Phone!;
            price = mainPage.Price ?? 20m;
            priceToKopeks = mainPage.PriceToKopeks;
            isDeliveryMode = mainPage.IsDeliveryPriceMode;
        }

        heroPriceText = BuildHeroPriceText(price, priceToKopeks, isDeliveryMode);

        if (currentCity != null)
        {
            promo = await Db.PromoMessages.AsNoTracking()
                .Where(p => p.IsActive && p.CityId == currentCity.Id)
                .FirstOrDefaultAsync();

            if (promo == null && mainPage.IsGlobalPromoShownOnCityPages)
            {
                promo = await Db.PromoMessages.AsNoTracking()
                    .Where(p => p.IsActive && p.CityId == null)
                    .FirstOrDefaultAsync();
            }
        }
        else
        {
            promo = await Db.PromoMessages.AsNoTracking()
                .Where(p => p.IsActive && p.CityId == null)
                .FirstOrDefaultAsync();
        }

        // На общей странице сначала решаем, нужно ли окно выбора города (это видно только в браузере),
        // и лишь потом показываем промо — чтобы два окна не появлялись одновременно.
        isPromoVisible = promo != null && !IsCitySelectorApplicable;

        await LoadGoalsAsync();
        Calculate();
    }

    private async Task LoadGoalsAsync()
    {
        var currentYear = DateTime.Now.Year;

        goal = await Db.Goals.AsNoTracking()
            .Where(g => g.IsActive && g.Year == currentYear)
            .OrderByDescending(g => g.StartDate)
            .FirstOrDefaultAsync();

        if (goal == null)
        {
            // Goals are now created only by the admin. A page view must not undo deactivation.
            totalClientsDisplay = totalItemsDisplay = ProgresPercent = 0;
            return;
        }

        totalClientsDisplay = AdminReporting.Completed(goal);
        totalItemsDisplay = goal.ActualItems;

        var clientsProgress = AdminReporting.Completed(goal);

        if (goal.TargetClients > 0)
            progressPercentDisplay = (int)Math.Round(100.0 * clientsProgress / goal.TargetClients);
        else
            progressPercentDisplay = 0;

        ProgresPercent = progressPercentDisplay;
    }

    private static int CalculateVirtualAdds(DateTime start, DateTime now)
    {
        if (now <= start)
            return 0;

        int total = 0;
        var day = start.Date;

        while (day <= now.Date)
        {
            for (int hour = 8; hour <= 21; hour++)
            {
                var point = day.AddHours(hour);
                if (point > now)
                    break;

                if (point >= start)
                    total++;
            }

            day = day.AddDays(1);
        }

        return total;
    }

    #endregion

    #region Инициализация JS

    private bool _jsInitialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _jsInitialized)
            return;

        _jsInitialized = true;

        try
        {
            // Одна точка инициализации всех анимаций/виджетов страницы (см. wwwroot/js/custom/custom.js).
            await JS.InvokeVoidAsync("ecobay.initPage");
        }
        catch (Exception ex)
        {
            Console.WriteLine("JS init error in Home: " + ex.Message);
        }

        await DecideCitySelectorAsync();
    }

    #endregion

    #region Окно выбора города

    private bool isCitySelectorVisible;
    private string? selectedSlug;
    private string? citySearch;

    private bool IsCitySelectorApplicable =>
        !isCityMode && mainPage.IsCitySelectorEnabled && activeCities.Count > 0;

    private IEnumerable<City> FilteredSelectorCities =>
        string.IsNullOrWhiteSpace(citySearch)
            ? activeCities
            : activeCities.Where(c => c.Name.Contains(citySearch.Trim(), StringComparison.OrdinalIgnoreCase));

    private string? SelectedCityName => activeCities.FirstOrDefault(c => c.Slug == selectedSlug)?.Name;

    private async Task DecideCitySelectorAsync()
    {
        if (activeCities.Count == 0)
            return;

        string? saved = null;
        try
        {
            await JS.InvokeVoidAsync("ecobayCity.setRemember", mainPage.IsRememberCityEnabled);
            saved = await JS.InvokeAsync<string?>("ecobayCity.get");
        }
        catch (Exception ex)
        {
            Console.WriteLine("City selector JS error: " + ex.Message);
        }

        var savedCityValid = saved is not null && activeCities.Any(c => c.Slug == saved);
        var forceChoose = ChooseCityQuery is not null;

        if (forceChoose && !isCityMode)
        {
            // Явный запрос «Сменить город» (или пришли с несуществующего города).
            if (saved is not null && saved != "all" && !savedCityValid)
                await SafeJs("ecobayCity.clear");
            ShowCitySelector(savedCityValid ? saved : null);
        }
        else if (IsCitySelectorApplicable && AllBelarusQuery is null)
        {
            if (saved == "all")
            {
                // Пользователь уже выбрал «Вся Беларусь».
            }
            else if (savedCityValid && mainPage.IsRememberCityEnabled)
            {
                // Подстраховка к скрипту в <head>: сразу открываем запомненный город.
                Nav.NavigateTo($"/{saved}", forceLoad: true);
                return;
            }
            else
            {
                ShowCitySelector(null);
            }
        }

        if (!isCitySelectorVisible && promo != null && !isPromoVisible && !isCityMode)
            isPromoVisible = true;

        StateHasChanged();
    }

    private void ShowCitySelector(string? preselect)
    {
        selectedSlug = preselect;
        citySearch = null;
        isPromoVisible = false;
        isCitySelectorVisible = true;
        _ = SafeJs("ecobay.lockScroll", true);
    }

    private void OpenCitySelector()
    {
        ShowCitySelector(currentCity?.Slug);
    }

    private async Task ConfirmCityAsync(string? slugToOpen)
    {
        if (string.IsNullOrWhiteSpace(slugToOpen) || activeCities.All(c => c.Slug != slugToOpen))
            return;

        await SafeJs("ecobayCity.set", slugToOpen);

        if (isCityMode && currentCity?.Slug == slugToOpen)
        {
            await CloseSelectorUiAsync();
            return;
        }

        Nav.NavigateTo($"/{slugToOpen}", forceLoad: true);
    }

    private async Task ChooseAllBelarusAsync()
    {
        await SafeJs("ecobayCity.set", "all");

        if (isCityMode)
        {
            Nav.NavigateTo("/?all=1", forceLoad: true);
            return;
        }

        await CloseSelectorUiAsync();
        if (promo != null)
            isPromoVisible = true;
    }

    private async Task CloseCitySelectorAsync()
    {
        // Закрыли крестиком — не спрашиваем снова до конца сеанса, но выбор не запоминаем.
        if (!isCityMode)
            await SafeJs("ecobayCity.dismiss");

        await CloseSelectorUiAsync();
        if (!isCityMode && promo != null)
            isPromoVisible = true;
    }

    private async Task CloseSelectorUiAsync()
    {
        isCitySelectorVisible = false;
        await SafeJs("ecobay.lockScroll", false);
    }

    private async Task SafeJs(string identifier, params object?[] args)
    {
        try
        {
            await JS.InvokeVoidAsync(identifier, args);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"JS call {identifier} failed: {ex.Message}");
        }
    }

    #endregion

    #region Отправка заявки

    private RequestFormModel form = new();
    private bool isSending;
    private bool isSuccessMessageVisible;

    private async Task OnSubmitAsync()
    {
        if (isSending)
            return;

        isSending = true;
        isSuccessMessageVisible = false;
        formErrorMessage = null;

        try
        {
            form.Phone = NormalizePhone(form.Phone ?? string.Empty);

            var digits = new string((form.Phone ?? string.Empty)
                .Where(char.IsDigit)
                .ToArray());

            if (string.IsNullOrWhiteSpace(form.Phone) || digits.Length == 0)
            {
                formErrorMessage = "Укажите телефон.";
                return;
            }

            if (digits.Length < 9 || digits.Length > 15)
            {
                formErrorMessage = "Телефон должен содержать от 9 до 15 цифр.";
                return;
            }

            var last9 = GetLast9Digits(form.Phone!);
            if (string.IsNullOrEmpty(last9))
            {
                formErrorMessage = "Не удалось распознать номер телефона.";
                return;
            }

            var client = await Db.Clients
                .FirstOrDefaultAsync(c => c.Phone.EndsWith(last9));

            if (client == null)
            {
                client = new Client
                {
                    Name = form.Name ?? string.Empty,
                    Phone = form.Phone,
                    Comment = form.Comment,
                    CityId = currentCity?.Id
                };

                Db.Clients.Add(client);
                await Db.SaveChangesAsync();
            }
            else
            {
                if (!string.IsNullOrWhiteSpace(form.Name))
                    client.Name = form.Name;

                if (!string.IsNullOrWhiteSpace(form.Comment))
                    client.Comment = form.Comment;

                await Db.SaveChangesAsync();
            }

            var request = new Request
            {
                ClientId = client.Id,
                PageCityId = pageCity?.Id,
                DateCreate = DateTime.Now,
                Message = form.Comment,
                Source = slug is null ? "/" : $"/{slug}"
            };

            Db.Requests.Add(request);
            await Db.SaveChangesAsync();

            // Read the current active goal: the admin may have changed it since this page was opened.
            var goalYear = DateTime.Now.Year;
            var activeGoalId = await Db.Goals.AsNoTracking()
                .Where(g => g.IsActive && g.Year == goalYear)
                .OrderByDescending(g => g.StartDate).ThenByDescending(g => g.Id)
                .Select(g => (long?)g.Id).FirstOrDefaultAsync();
            if (activeGoalId.HasValue)
            {
                await Db.Goals
                    .Where(g => g.Id == activeGoalId.Value && g.IsActive)
                    .ExecuteUpdateAsync(u => u
                        .SetProperty(g => g.ActualClients, g => g.ActualClients + 1)
                        .SetProperty(g => g.ActualItems, g => g.ActualItems + 1));
            }

            try
            {
                await EmailSender.SendRequestCreatedAsync(client, request, currentCity, pageCity);
            }
            catch (Exception ex)
            {
                Console.WriteLine("Email send error: " + ex);
            }

            form = new RequestFormModel();
            isSuccessMessageVisible = true;
        }
        finally
        {
            isSending = false;
        }
    }

    public class RequestFormModel
    {
        public string? Name { get; set; }
        public string? Phone { get; set; }
        public string? Comment { get; set; }
    }

    private static string NormalizePhone(string phone)
    {
        if (string.IsNullOrWhiteSpace(phone))
            return phone;

        var cleaned = new string(phone.Where(c => char.IsDigit(c) || c == '+').ToArray());

        if (cleaned.StartsWith("+375"))
            return cleaned;

        if (cleaned.StartsWith("375"))
            return "+" + cleaned;

        var digits = new string(cleaned.Where(char.IsDigit).ToArray());
        if (digits.Length == 9)
            return "+375" + digits;

        return cleaned;
    }

    private static string GetLast9Digits(string input)
    {
        var digits = new string(input.Where(char.IsDigit).ToArray());
        if (digits.Length <= 9)
            return digits;

        return digits[^9..];
    }

