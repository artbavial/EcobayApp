@page "/"
@page "/{slug:nonfile?}"
@rendermode InteractiveServer
@inject AppDBContext Db
@inject IEmailSender EmailSender
@inject IJSRuntime JS
@inject NavigationManager Nav
@using EcobayApp.Contex
@using EcobayApp.Models
@using EcobayApp.Services
@using System.Net
@using System.Net.Mail
@using Microsoft.EntityFrameworkCore
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Web


<PageTitle>@Title</PageTitle>
<HeadContent>
    <meta name="description" content="@MetaDescription" />
    <meta name="keywords" content="@MetaKeywords" />
    <link rel="canonical" href="@CanonicalUrl" />
</HeadContent>


<div id="scroll-content" data-interactive-page>
    <!-- hero -->
    <header id="top" class="d-flex flex-column">
        <!-- Desktop Menu -->
        <nav class="starta-nav">
            <div class="container d-flex justify-content-between align-items-center">
                <a class="logo text-decoration-none" href="@SectionUrl("top")">
                    <img src="images/hero/icon.png" alt="Icon" />Ecobay<span>.by</span>
                </a>

                <ul class="list-unstyled starta-menu">
                    <li><a class="menu-animation active" href="@SectionUrl("top")">Начало</a></li>
                    <li><a class="menu-animation" href="@SectionUrl("about")">О нас</a></li>
                    <li><a class="menu-animation" href="@SectionUrl("services")">Что принимаем</a></li>
                    <li><a class="menu-animation" href="@SectionUrl("plan")">Цены</a></li>
                    <li><a class="menu-animation" href="@SectionUrl("team")">Наша работа</a></li>
                    <li><a class="menu-animation" href="@SectionUrl("faqs")">Частые вопросы</a></li>
                </ul>

                <a href="tel:@phone" class="starta-helpline">
                    <i class="fa-solid fa-phone-volume"></i>
                    <article>
                        <h4>Связаться с нами</h4>
                        <p>@phone</p>
                    </article>
                </a>
            </div>
        </nav>

        <!-- Mobile Menu Icon -->
        <button type="button" class="menuIcon" id="menuBtn" aria-label="Меню">
            <span></span>
            <span></span>
            <span></span>
        </button>

        <!-- Mobile Menu -->
        <nav class="starta-mobile-nav">
            <ul class="list-unstyled starta-menu">
                <li><a class="menu-animation active" href="@SectionUrl("top")">Начало</a></li>
                <li><a class="menu-animation" href="@SectionUrl("about")">О нас</a></li>
                <li><a class="menu-animation" href="@SectionUrl("services")">Что принимаем</a></li>
                <li><a class="menu-animation" href="@SectionUrl("plan")">Цены</a></li>
                <li><a class="menu-animation" href="@SectionUrl("team")">Наша работа</a></li>
                <li><a class="menu-animation" href="@SectionUrl("faqs")">Частые вопросы</a></li>
                @if (activeCities.Count > 0)
                {
                    <li>
                        <a class="mobile-city-link" href="/?choose-city=1" @onclick="OpenCitySelector" @onclick:preventDefault="true">
                            <i class="fa-solid fa-location-dot"></i> @(currentCity?.Name ?? "Города и районы") · сменить
                        </a>
                    </li>
                }
            </ul>
        </nav>



        <div class="container d-flex flex-column flex-grow-1 position-relative z-index-3">
            <!-- hero section -->
            <section class="starta-hero my-5 d-flex flex-column justify-content-center flex-grow-1">
                @* Выбор города — отдельной строкой над текстом и формой, чтобы первый экран был компактнее. *@
                @if (activeCities.Count > 0)
                {
                    <div class="row mt-4 pt-2">
                        <div class="col-12 text-md-start text-center">
                            <div class="hero-city-bar hero-city-bar-top">
                                <i class="fa-solid fa-location-dot"></i>
                                <span class="hero-city-name">@(currentCity?.Name ?? "Города и районы")</span>
                                <a class="hero-city-change" href="/?choose-city=1" @onclick="OpenCitySelector" @onclick:preventDefault="true">Сменить город</a>
                            </div>
                        </div>
                    </div>
                }
                <div class="row @(activeCities.Count > 0 ? "mt-1" : "mt-5 pt-4")">
                    <!-- ТЕКСТОВАЯ КОЛОНКА ВВЕРХУ (на мобиле и десктопе) -->
                    <div class="col-12 col-md-7 text-md-start text-center">
                        <h1 class="heroHeading">
                            @if (currentCity is not null)
                            {
                                @(string.IsNullOrWhiteSpace(pageCity?.HeroTitle)
                                    ? $"Вывоз техники в {currentCity.NameIn} и населённых пунктах района"
                                    : pageCity!.HeroTitle)
                            }
                            else
                            {
                                @(string.IsNullOrWhiteSpace(mainPage.HeroTitle) ? "Вывоз техники в наших городах и их районах" : mainPage.HeroTitle)
                            }
                        </h1>
                        @if (isCityMode)
                        {
                            <p class="hero-coverage-note">Обслуживаем этот город и его район. Выезд в населённый пункт района согласуем по телефону.</p>
                        }

                        @if (IsDeliveryPriceModeActive)
                        {
                            <div class="heroPriceCompact d-block d-md-none">
                                <div class="heroPriceCompact-row">
                                    <div class="heroPriceCompact-value heroPriceCompact-value-from">
                                        <span class="heroPriceCompact-prefix">от</span>
                                        <span class="heroPriceCompact-number">@((int)price)</span>
                                        <span class="heroPriceCompact-unit">коп./кг</span>
                                    </div>
                                    <div class="heroPriceCompact-content">
                                        <div class="heroPriceCompact-title">МЫ ПЛАТИМ</div>
                                        <div class="heroPriceCompact-text">
                                            если сами приедем, вынесем и вывезем технику.
                                        </div>
                                    </div>
                                </div>

                                <div class="heroPriceCompact-divider"></div>

                                <div class="heroPriceCompact-row">
                                    <div class="heroPriceCompact-value">
                                        <span class="heroPriceCompact-number">@priceToKopeks</span>
                                        <span class="heroPriceCompact-unit">коп./кг</span>
                                    </div>
                                    <div class="heroPriceCompact-content">
                                        <div class="heroPriceCompact-title">МЫ ПЛАТИМ БОЛЬШЕ</div>
                                        <div class="heroPriceCompact-text">
                                            если вы сами привезёте технику в передвижной пункт приёма.
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="heroPriceCards heroPriceCards-desktop d-none d-md-grid">
                                <div class="heroPriceCard">
                                    <div class="heroPriceCard-price">от @((int)price) коп./кг</div>
                                    <div class="heroPriceCard-title">МЫ платим</div>
                                    <div class="heroPriceCard-text">
                                        если сами приедем, отключим, вынесем и вывезем технику.
                                    </div>
                                </div>

                                <div class="heroPriceCard heroPriceCard-accent">
                                    <div class="heroPriceCard-price">@priceToKopeks коп./кг</div>
                                    <div class="heroPriceCard-title">МЫ платим больше</div>
                                    <div class="heroPriceCard-text">
                                        если вы сами привезёте технику в наш передвижной пункт приёма.
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <p class="heroDesc d-block d-md-none heroDesc-mobile">
                                @(HeroTextOverride ?? "Заберём технику в любом состоянии по вашему адресу, сами вынесем и погрузим.")
                            </p>
                            <p class="heroDesc heroDesc-desktopLarge d-none d-md-block">
                                @(HeroTextOverride ?? "Мы сами приедем по вашему адресу, вынесем и погрузим технику в любом состоянии. Без хлопот для вас и с пользой для экологии.")
                            </p>

                            <div class="heroPayBadge" aria-label="@($"Мы платим {heroPriceText} за килограмм")">
                                <div class="heroPayBadge-label">МЫ ПЛАТИМ</div>
                                <div class="heroPayBadge-value">
                                    @if (HasPriceRange)
                                    {
                                        <span class="heroPayBadge-num">@((int)price)</span>
                                        <span class="heroPayBadge-dash">–</span>
                                        <span class="heroPayBadge-num">@priceToKopeks</span>
                                    }
                                    else
                                    {
                                        <span class="heroPayBadge-prefix">от</span>
                                        <span class="heroPayBadge-num">@((int)price)</span>
                                    }
                                    <span class="heroPayBadge-unit">коп.<br />за кг</span>
                                </div>
                                <div class="heroPayBadge-note">
                                    <i class="fa-solid fa-scale-balanced" aria-hidden="true"></i>
                                    Взвесим и оплатим сразу на месте
                                </div>
                            </div>
                        }

                        <div class="hero-primary-contact">
                            <a href="tel:@phone" class="starta-button call-button">
                                <span class="position-relative"><i class="fa-solid fa-phone" aria-hidden="true"></i> @phone</span>
                                <span class="starta-button-hover"></span>
                            </a>
                            <span>Позвоните и согласуйте вывоз. Заявки принимаем ежедневно.</span>
                        </div>

                        @if (!isCityMode)
                        {
                            <div class="hero-cities">
                                <span class="hero-cities-label">Работаем ТОЛЬКО в указанных городах и их районах</span>
                                @if (activeCities.Count == 0)
                                {
                                    <p class="hero-cities-note">Список обслуживаемых городов временно недоступен. Уточните возможность вывоза по телефону.</p>
                                }
                                else if (mainPage.IsCityListShown)
                                {
                                    <div class="hero-cities-list">
                                        @foreach (var c in activeCities)
                                        {
                                            <a class="hero-city-chip" href="@($"/{c.Slug}")" onclick="@($"window.ecobayCity && ecobayCity.set('{c.Slug}')")">@c.Name</a>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <p class="hero-cities-note">@string.Join(", ", activeCities.Select(c => c.Name))</p>
                                }
                                <span class="hero-cities-note">Населённые пункты районов этих городов также обслуживаем. В остальных городах и районах вывоз не выполняем.</span>
                            </div>
                        }

                    </div>

                    <!-- ФОРМА (Вторая колонка на десктопе, внизу на мобиле) -->
                    <div class="col-12 col-md-5 position-relative mt-5 mt-md-0">
                        <!-- Shapes (ТОЛЬКО на десктопе) -->
                        <div class="shapes d-none d-md-block">
                            <img src="images/hero/shape1.svg" alt="shape" />
                            <img src="images/hero/shape2.svg" alt="shape" />
                            <img src="images/hero/shape3.svg" alt="shape" />
                        </div>

                        <EditForm Model="form" OnValidSubmit="OnSubmitAsync">

                            <div class="heroForm">
                                <article class="formContent">
                                    <h2 class="starta-h2">Оставьте заявку</h2>
                                    <p class="starta-desc">
                                        Мы свяжемся с вами в ближайшее время
                                    </p>
                                </article>

                                <div class="inputField">
                                    <InputText class="starta-desc"
                                               @bind-Value="form.Name"
                                               placeholder="Ваше имя" />
                                    <i class="fa-solid fa-user"></i>
                                </div>

                                <div class="inputField">
                                    <InputText class="starta-desc"
                                                @bind-Value="form.Phone"
                                                placeholder="Ваш телефон"
                                               @onfocus="EventCallback.Factory.Create(this, OnPhoneFocus)" />
                                </div>

                                <div class="inputField messageField">
                                    <InputTextArea class="starta-desc"
                                                   @bind-Value="form.Comment"
                                                   rows="3"
                                                   placeholder="Ваше сообщение" />
                                    <i class="fa-solid fa-comment"></i>
                                </div>

                                <div class="border-bottom pt-4 mb-4"></div>

                                <button class="starta-button w-100"
                                        type="submit"
                                        disabled="@isSending">
                                    <span class="position-relative">
                                        @(isSending ? "Отправка..." : "Отправить заявку")
                                    </span>
                                    <span class="starta-button-hover"></span>
                                </button>

                                @if (!string.IsNullOrEmpty(formErrorMessage))
                                {
                                    <p class="starta-desc mt-3" style="color:#dc3545;">
                                        @formErrorMessage
                                    </p>
                                }
                                else if (isSuccessMessageVisible)
                                {
                                    <p class="starta-desc mt-3" style="color:#28a745;">
                                        Заявка успешно отправлена. Мы свяжемся с вами в ближайшее время.
                                    </p>
                                }
                            </div>
                        </EditForm>
                    </div>
                </div>
            </section>
        </div>

        <!-- Hero Background -->
        <div class="heroBG">
            <img src="images/hero/bg.jpg" alt="Background" />
        </div>
    </header>

    @if (isCityMode && pageCity is not null &&
        (!string.IsNullOrWhiteSpace(pageCity.LocalIntro) || !string.IsNullOrWhiteSpace(pageCity.CoverageText) || !string.IsNullOrWhiteSpace(pageCity.PickupDetails)))
    {
        <section class="city-local-section py-5">
            <div class="container">
                <h2 class="starta-h2 mb-4">Вывоз техники в @currentCity!.NameIn: местные условия</h2>
                <div class="row g-4">
                    @if (!string.IsNullOrWhiteSpace(pageCity.LocalIntro))
                    {
                        <div class="col-lg"><article class="city-local-card"><h3>О работе в городе</h3><p>@pageCity.LocalIntro</p></article></div>
                    }
                    @if (!string.IsNullOrWhiteSpace(pageCity.CoverageText))
                    {
                        <div class="col-lg"><article class="city-local-card"><h3>Город и населённые пункты района</h3><p>@pageCity.CoverageText</p></article></div>
                    }
                    @if (!string.IsNullOrWhiteSpace(pageCity.PickupDetails))
                    {
                        <div class="col-lg"><article class="city-local-card"><h3>Как организовать вывоз</h3><p>@pageCity.PickupDetails</p></article></div>
                    }
                </div>
            </div>
        </section>
    }

    <!-- Starta about -->
    <!-- Features -->
    <section class="startaFeatures" id="about">
        <div class="container">
            <div class="row my-5 pb-4 justify-content-between align-items-center">
                <!-- Feature single -->
                <div class="col-md-4 col-sm-6">
                    <div class="row align-items-center featureSingle">
                        <div class="col-md-4">
                            <i class="starta-icon featureIcon fa-regular fa-lightbulb"></i>
                        </div>
                        <div class="col-md-7">
                            <article>
                                <h4 class="starta-h4">Экологично</h4>
                                <p class="starta-desc">
                                    Вся техника гарантированно будет переработана
                                </p>
                            </article>
                        </div>
                    </div>
                </div>
                <!-- feature single -->
                <div class="col-md-4 col-sm-6">
                    <div class="row align-items-center featureSingle">
                        <div class="col-md-4">
                            <i class="starta-icon featureIcon fa-regular fa-lightbulb"></i>
                        </div>
                        <div class="col-md-7">
                            <article>
                                <h4 class="starta-h4">Удобно</h4>
                                <p class="starta-desc">
                                    Вынесем и погрузим самостоятельно.
                                </p>
                            </article>
                        </div>
                    </div>
                </div>
                <!-- feature single -->
                <div class="col-md-4 col-sm-6">
                    <div class="row align-items-center featureSingle">
                        <div class="col-md-4">
                            <i class="starta-icon featureIcon fa-regular fa-lightbulb"></i>
                        </div>
                        <div class="col-md-7">
                            <article>
                                <h4 class="starta-h4">Выгодно</h4>
                                <p class="starta-desc">
                                    Вы получите деньги сразу на месте.
                                </p>
                            </article>
                        </div>
                    </div>
                </div>
            </div>

            <!-- gap -->
            <div class="lineGap my-4"></div>
            <div class="row my-5 py-md-4">
                <!-- Starta BLock -->
                <div class="col-md-6 position-relative">
                    <img class="starta-block-img1 animate-img"
                         src="images/main/block1.png"
                         alt="Block" />

                    <div class="starta-performance">
                        <h4 class="starta-h4 fw-normal mb-3">Наши цели @thisYear</h4>
                        <div class="row pb-3 border-bottom">
                            <div class="col-md-6 col-sm-6 col-6">
                                <div class="row">
                                    <div class="col-md-4 pe-0">
                                        <i class="performance-icon fa-solid fa-display"></i>
                                    </div>
                                    <div class="col-md-8 ps-1">
                                        <article>
                                            <h4 class="starta-h4 d-flex align-items-center fw-normal mb-0">
                                                @totalClientsDisplay<i class="fa-solid fa-arrow-up"></i>
                                            </h4>
                                            <p class="starta-descbox">Клиентов из @(goal?.TargetClients ?? 0)</p>
                                        </article>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6 col-sm-6 col-6">
                                <div class="row">
                                    <div class="col-md-4 pe-0">
                                        <i class="performance-icon fa-solid fa-signal"></i>
                                    </div>
                                    <div class="col-md-8 ps-1">
                                        <article>
                                            <h4 class="starta-h4 d-flex align-items-center fw-normal mb-0">
                                                @totalItemsDisplay<i class="fa-solid fa-arrow-up"></i>
                                            </h4>
                                            <p class="starta-descbox">Ед. техники из @(goal?.TargetItems ?? 0)</p>
                                        </article>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <h5 class="starta-h5 my-3">
                            Выполнение цели <span>@ProgresPercent%</span>
                        </h5>
                        <div class="bar">
                            <div class="fill" data-progress="@ProgressClamped" style="--p:@(ProgressClamped)%;"></div>
                        </div>
                    </div>


                </div>

                <!-- About Content -->
                <div class="col-md-6 mt-3">
                    <h2 class="starta-heading">
                        <i class="fa-solid fa-star"></i>Наши достижения.
                    </h2>
                    <h1 class="starta-h1">Мы занимаемся вывозом бытовой техники с 2018 года</h1>
                    <p class="starta-desc">
                        За это время мы вывезли на утилизацию и переработу тысячи тонн техники, среди которых тысячи холодильников, телевизоров, стиральных машин, газовых плинт. Десятки тысяч мелкой бытовой техники.
                        <a href="">Наша работа очень важна для экологии и будущего.</a>
                        В ежедневном режиме наша служба продолжает помогать многим людям избавляя от хлама квартиры, дома и дачи. Ждем твоей заявки.
                    </p>
                    <div class="row my-3">

                        <div class="col-md-7">
                            <ul class="starta-list list-unstyled">
                                <li>
                                    <i class="fa-solid fa-circle-check"></i>Много клиентов обращаются повторно!
                                </li>
                                <li>
                                    <i class="fa-solid fa-circle-check"></i>Каждая ваша заявка важна !
                                </li>
                                <li>
                                    <i class="fa-solid fa-circle-check"></i>Честный расчет!
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

   

    <!-- Starta Project -->
    <section id="services" class="starta-service">
        <div class="container">
            <div class="row mt-3">
                <!-- Правая колонка -->
                <div class="col-md-6">
                    <h2 class="starta-heading">Что мы принимаем</h2>
                    <h1 class="starta-h1">
                        Мы принимаем любую бытовую технику!
                    </h1>
                    <p class="starta-desc">
                        Заберем технику в любом состоянии, исправном и не исправном.
                    </p>
                    <img class="starta-block-img mt-3"
                         src="images/main/project/blockImg2.png"
                         alt="Block Img" />
                </div>
                <div class="col-md-6 pe-md-5">
                    <!-- Video BLock -->
                    <div class="video-block mb-4 d-none d-md-block">
                        <img class="starta-block-img"
                             src="images/main/project/videoBG.jpg"
                             alt="BG" />

                        <!-- PLay Button -->
                        <button type="button" class="playBtn startplay" aria-label="Смотреть видео">
                            <i class="fa-solid fa-play"></i>
                            <svg id="circle-text" viewBox="0 0 160 160" aria-hidden="true" focusable="false">
                                <defs><path id="ecobay-video-ring" d="M80,80 m-61,0 a61,61 0 1,1 122,0 a61,61 0 1,1 -122,0" /></defs>
                                <text><textPath href="#ecobay-video-ring" textLength="383.27" lengthAdjust="spacing">СМОТРЕТЬ ВИДЕО · СМОТРЕТЬ ВИДЕО · </textPath></text>
                            </svg>
                        </button>

                        <!-- video frame -->
                        <iframe data-src="https://www.youtube.com/embed/e0TblOS6o_s?controls=0"
                                title="Sample Video"
                                frameborder="0"
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                                referrerpolicy="strict-origin-when-cross-origin"
                                allowfullscreen></iframe>
                        <i class="close fa-solid fa-circle-xmark"></i>
                    </div>


                    <!-- Списки -->
                    <div class="row">
                        <div class="col-md-6">
                            <ul class="starta-list list-unstyled">
                                <li class="mb-3">
                                    <i class="fa-solid fa-circle-check"></i> Холодильники и морозильники
                                </li>
                                <li class="mb-3">
                                    <i class="fa-solid fa-circle-check"></i> Стиральные машины.
                                </li>
                                <li class="mb-3">
                                    <i class="fa-solid fa-circle-check"></i> Газовые плиты.
                                </li>
                            </ul>
                        </div>
                        <div class="col-md-6">
                            <ul class="starta-list list-unstyled">
                                <li class="mb-3">
                                    <i class="fa-solid fa-circle-check"></i> Телевизоры любые.
                                </li>
                                <li class="mb-3">
                                    <i class="fa-solid fa-circle-check"></i> Иная бытовая техника.
                                </li>
                                <li class="mb-3">
                                    <i class="fa-solid fa-circle-check"></i> Компьютеры и электроника.
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="starta-plans" id="plan">
        <div class="container">
            <h1 class="starta-heading mx-auto">Цены за бытовую технику</h1>
            <h1 class="starta-h1 text-center">
                Самое интересное, сколько денег можно получить! :)
            </h1>

            <div class="row justify-content-center">
                <!-- Калькулятор -->
                <div class="col-md-5 lap-sm-50 tab-100">
                    <div class="plan best">
                        <div class="row align-items-center">
                            <div class="col-md-5 col-sm-3 col-5">
                                <i class="starta-icon featureIcon fa-solid fa-scale-balanced"></i>
                            </div>

                            <div class="col-md-7 p-md-0 col-sm-9 col-7">
                                <article class="plan-heading">
                                    <h3 class="starta-h2">Калькулятор цены</h3>

                                    @if (IsDeliveryPriceModeActive)
                                    {
                                        <p class="starta-desc mb-0 calculator-subtitle">
                                            <strong>МЫ платим:</strong><br />
                                            при выезде — <strong>@((int)price) коп./кг</strong><br />
                                            при самопривозе — <strong>@priceToKopeks коп./кг</strong>
                                        </p>
                                    }
                                    else if (priceToKopeks.HasValue && priceToKopeks.Value > (int)price)
                                    {
                                        <p class="starta-desc mb-0 calculator-subtitle">
                                            <strong>МЫ выкупаем и платим</strong><br />
                                            от <strong>@((int)price)</strong> до <strong>@priceToKopeks</strong> коп./кг
                                        </p>
                                    }
                                    else
                                    {
                                        <p class="starta-desc mb-0 calculator-subtitle">
                                            <strong>МЫ выкупаем и платим</strong><br />
                                            от <strong>@((int)price)</strong> коп./кг
                                        </p>
                                    }
                                </article>
                            </div>

                            <div class="my-4">
                                <input type="number"
                                       class="form-control calculator-weight-input"
                                       placeholder="Введите вес (кг)"
                                       @bind="weight"
                                       min="0"
                                       step="0.1"
                                       @oninput="Calculate" />
                            </div>

                            <button class="starta-button" type="button" @onclick="Calculate">
                                <span class="position-relative">Рассчитать</span>
                                <span class="starta-button-hover"></span>
                            </button>

                            <div class="calculator-result starta-desc fw-medium mt-4">
                                @if (weight <= 0)
                                {
                                    <p style="min-height: 40px;">
                                        Введите корректный вес.
                                    </p>
                                }
                                else if (IsDeliveryPriceModeActive)
                                {
                                    <div class="calculator-result-item mb-3">
                                        <div class="calculator-result-label">
                                            <strong>МЫ платим вам @DeliveryTotal.ToString("0.00") руб.</strong>,
                                            если сами приедем, отключим, вынесем и вывезем технику.
                                        </div>
                                    </div>

                                    <div class="calculator-result-item">
                                        <div class="calculator-result-label">
                                            <strong>МЫ платим вам до @SelfDeliveryTotal.ToString("0.00") руб.</strong>,
                                            если вы сами привезёте технику в наш передвижной пункт приёма.
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <p style="min-height: 40px;">
                                        @((MarkupString)resultMessage)
                                    </p>
                                }
                            </div>
                        </div>

                        <span class="discount">
                            * Конечную цену уточняйте у менеджера
                        </span>
                    </div>
                </div>

                <!-- Справочный вес -->
                <div class="col-md-4 lap-sm-50 tab-100">
                    <div class="plan info">
                        <h3 class="starta-h2 text-center">Вес техники*</h3>
                        <strong>Вес указан в килограммах.</strong>
                        <ul class="starta-desc">
                            <li>Холодильник <strong>~ 45–80</strong></li>
                            <li>Стиральная машина <strong>~ 50–80</strong></li>
                            <li>Советская стиралка <strong>~ 10–45</strong></li>
                            <li>Телевизор <strong>~ 10–50</strong></li>
                            <li>Газовая плита <strong>~ 28–56</strong></li>
                            <li>Газовый котёл <strong>~ 40–150</strong></li>
                            <li>Газовая колонка <strong>~ 15–40</strong></li>
                        </ul>
                        <span class="discount">
                            * Указанные значения носят справочный характер.
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </section>


