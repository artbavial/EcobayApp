@page "/adminpanel"
@page "/admin"
@attribute [Authorize(Roles = AdminRoles.Admin)]
@rendermode InteractiveServer

@using System.Security.Claims
@using System.Text.RegularExpressions
@using EcobayApp.Contex
@using EcobayApp.Models
@using EcobayApp.Services
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDBContext> DbFactory
@inject AdminAuthService Auth
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Панель управления | Ecobay.by</PageTitle>
<HeadContent>
    <meta name="robots" content="noindex, nofollow" />
</HeadContent>

<div class="admin-shell">
    <header class="admin-topbar">
        <div class="container d-flex align-items-center justify-content-between gap-3 flex-wrap">
            <a class="admin-brand text-decoration-none" href="/adminpanel">
                <img src="images/hero/icon.png" alt="" />Ecobay<span>.by</span>
                <small>панель управления</small>
                <span class="admin-engine">ArtBavial Engine CMS v0.9</span>
            </a>
            <div class="d-flex align-items-center gap-3 flex-wrap">
                <a class="admin-link" href="/?all=1" target="_blank"><i class="fa-solid fa-arrow-up-right-from-square"></i> Открыть сайт</a>
                <span class="admin-user"><i class="fa-solid fa-user-shield"></i> @currentUserDisplay</span>
                <form method="post" action="/admin/logout" class="m-0">
                    <AntiforgeryToken />
                    <button type="submit" class="admin-btn admin-btn-ghost">Выйти</button>
                </form>
            </div>
        </div>
    </header>

    <div class="container my-4">
        @if (mustChangePassword)
        {
            <div class="admin-alert admin-alert-warn mb-3">
                <strong>Смените пароль.</strong> Вы вошли с паролем из файла конфигурации. Задайте свой пароль во вкладке «Пользователи».
            </div>
        }

        <ul class="admin-tabs">
            <li><button class="@(activeTab == AdminTab.Dashboard ? "active" : "")" @onclick="() => SetTab(AdminTab.Dashboard)"><i class="fa-solid fa-chart-line"></i> Дашборд</button></li>
            <li><button class="@(activeTab == AdminTab.Requests ? "active" : "")" @onclick="() => OpenRequests(false)"><i class="fa-solid fa-inbox"></i> Заявки</button></li>
            <li><button class="@(activeTab == AdminTab.Goals ? "active" : "")" @onclick="() => SetTab(AdminTab.Goals)"><i class="fa-solid fa-bullseye"></i> Цели</button></li>
            <li><button class="@(activeTab == AdminTab.Routes ? "active" : "")" @onclick="() => SetTab(AdminTab.Routes)"><i class="fa-solid fa-route"></i> Маршруты</button></li>
            <li><button class="@(activeTab == AdminTab.Feedback ? "active" : "")" @onclick="() => SetTab(AdminTab.Feedback)"><i class="fa-solid fa-comment-dots"></i> Обращения</button></li>
            <li><button class="@(activeTab == AdminTab.Cities ? "active" : "")" @onclick="() => SetTab(AdminTab.Cities)"><i class="fa-solid fa-city"></i> Города</button></li>
            <li><button class="@(activeTab == AdminTab.MainPage ? "active" : "")" @onclick="() => SetTab(AdminTab.MainPage)"><i class="fa-solid fa-flag"></i> Главная сайта</button></li>
            <li><button class="@(activeTab == AdminTab.Users ? "active" : "")" @onclick="() => SetTab(AdminTab.Users)"><i class="fa-solid fa-users-gear"></i> Пользователи</button></li>
        </ul>

        @switch (activeTab)
        {
            case AdminTab.Dashboard:
                <AdminDashboard OnRequests="() => OpenRequests(true)" OnGoals="() => SetTab(AdminTab.Goals)" />
                break;
            case AdminTab.Requests:
                <AdminRequests TodayOnly="requestsTodayOnly" IsAdmin="true" CurrentUserId="currentUserId" CurrentUserName="@currentUserDisplay" />
                break;
            case AdminTab.Goals:
                <AdminGoals />
                break;
            case AdminTab.Routes:
                <AdminRoutes />
                break;

            case AdminTab.Feedback:
                <AdminFeedback />
                break;

            case AdminTab.Cities:
                <AdminCities />
                break;
            case AdminTab.MainPage:
                @MainPageTab()
                break;
            case AdminTab.Users:
                @UsersTab()
                break;
        }
    </div>
    <footer class="admin-footer">© 2026 Разработка ArtBavial Software. Все права защищены.</footer>
</div>

@code {
    private enum AdminTab { Dashboard, Requests, Routes, Goals, Feedback, Cities, MainPage, Users }

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private AdminTab activeTab = AdminTab.Dashboard;
    private long currentUserId;
    private string currentUserDisplay = "";
    private bool mustChangePassword;
    private bool requestsTodayOnly;
    private bool saving;

    private static readonly Regex SlugRegex = new("^[a-z0-9]+(?:-[a-z0-9]+)*$", RegexOptions.Compiled);

    /// <summary>Адреса, которые заняты страницами сайта и не могут быть slug города.</summary>
    private static readonly HashSet<string> ReservedSlugs = new(StringComparer.OrdinalIgnoreCase)
    {
        "admin", "adminpanel", "contacts", "user-agreement", "error", "login", "logout",
        "css", "js", "images", "font", "bootstrap", "_framework", "_blazor"
    };

    private void SetTab(AdminTab tab) => activeTab = tab;

    private void OpenRequests(bool todayOnly)
    {
        requestsTodayOnly = todayOnly;
        activeTab = AdminTab.Requests;
    }

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var user = (await AuthState).User;
            long.TryParse(user.FindFirstValue(ClaimTypes.NameIdentifier), out currentUserId);
            currentUserDisplay = user.FindFirstValue("ecobay:display") ?? user.Identity?.Name ?? "";
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var me = await db.AdminUsers.AsNoTracking().FirstOrDefaultAsync(u => u.Id == currentUserId);
        mustChangePassword = me?.MustChangePassword == true;
        if (mustChangePassword)
            activeTab = AdminTab.Users;

        await LoadMainPageAsync(db);
        await LoadUsersAsync(db);
    }

    // ---------- Общие фрагменты разметки ----------

    private RenderFragment PromoFields(PromoMessage promo, string idPrefix) => __builder =>
    {
        <div class="form-check form-switch mb-3 admin-switch">
            <input class="form-check-input" type="checkbox" id="@(idPrefix + "Active")" @bind="promo.IsActive" />
            <label class="form-check-label" for="@(idPrefix + "Active")">Показывать промо</label>
        </div>
        <div class="mb-3">
            <label class="admin-label">Заголовок</label>
            <input class="form-control" @bind="promo.Title" maxlength="160" />
        </div>
        <div class="mb-3">
            <label class="admin-label">Текст</label>
            <textarea class="form-control" rows="4" @bind="promo.Text" maxlength="500"></textarea>
        </div>
    };

    private static RenderFragment StatusMessage(string? message, bool isError) => __builder =>
    {
        if (!string.IsNullOrEmpty(message))
        {
            <p class="@(isError ? "admin-status-error" : "admin-status-ok") mt-2 mb-0">@message</p>
        }
    };

    // =====================================================================
    // MAIN PAGE — «Вся Беларусь»
    // =====================================================================

    private MainPageSettings mainPage = DbSeeder.CreateDefaultMainPage();
    private PromoMessage globalPromo = new() { Title = "Внимание!", Text = "", IsActive = false };
    private string? mainMessage; private bool mainError;
    private string? globalPromoMessage; private bool globalPromoError;

    private async Task LoadMainPageAsync(AppDBContext db)
    {
        mainPage = await db.MainPageSettings.AsNoTracking().OrderBy(s => s.Id).FirstOrDefaultAsync()
                   ?? DbSeeder.CreateDefaultMainPage();

        globalPromo = await db.PromoMessages.AsNoTracking().Where(p => p.CityId == null).OrderBy(p => p.Id).FirstOrDefaultAsync()
                      ?? new PromoMessage { Title = "Внимание!", Text = "", IsActive = false };
    }

    private RenderFragment MainPageTab() => __builder =>
    {
        <div class="admin-hint mb-3">
            <i class="fa-solid fa-circle-info"></i>
            Общая страница открывается по адресу <a href="/?all=1" target="_blank">ecobay.by/</a>, если посетитель не выбрал город.
            Здесь настраивается окно выбора города. Работаем только в активных городах и их районах, а не по всей Беларуси.
        </div>

        <div class="row g-3">
            <div class="col-lg-4">
                <div class="admin-card">
                    <h2 class="admin-card-title">SEO</h2>
                    <div class="mb-3">
                        <label class="admin-label">Title страницы</label>
                        <input class="form-control" @bind="mainPage.Title" maxlength="160" />
                    </div>
                    <div class="mb-3">
                        <label class="admin-label">Описание (meta description)</label>
                        <textarea class="form-control" rows="3" @bind="mainPage.Description" maxlength="300"></textarea>
                        <small class="admin-muted">Если пусто — сформируется автоматически по списку активных городов.</small>
                    </div>
                    <div class="mb-3">
                        <label class="admin-label">Ключевые слова</label>
                        <textarea class="form-control" rows="2" @bind="mainPage.KeyWords" maxlength="300"></textarea>
                    </div>

                    <h2 class="admin-card-title mt-4">Первый экран</h2>
                    <div class="mb-3">
                        <label class="admin-label">Заголовок (H1)</label>
                        <input class="form-control" @bind="mainPage.HeroTitle" maxlength="200" placeholder="Вывоз техники в наших городах и их районах" />
                    </div>
                    <div class="mb-3">
                        <label class="admin-label">Текст под заголовком</label>
                        <textarea class="form-control" rows="3" @bind="mainPage.HeroText" maxlength="600"
                                  placeholder="Если пусто — стандартный текст о выезде и оплате на месте."></textarea>
                    </div>
                    <div class="form-check form-switch admin-switch">
                        <input class="form-check-input" type="checkbox" id="mainCityList" @bind="mainPage.IsCityListShown" />
                        <label class="form-check-label" for="mainCityList">Показывать города кнопками (иначе списком)</label>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="admin-card">
                    <h2 class="admin-card-title">Контакты и цены</h2>
                    <div class="mb-3">
                        <label class="admin-label">Телефон</label>
                        <input class="form-control" @bind="mainPage.Phone" maxlength="50" />
                    </div>
                    <div class="mb-3">
                        <label class="admin-label">Цена ОТ (коп./кг)</label>
                        <InputNumber class="form-control" TValue="decimal?" @bind-Value="mainPage.Price" />
                    </div>
                    <div class="mb-3">
                        <label class="admin-label">Цена ДО (коп./кг)</label>
                        <InputNumber class="form-control" TValue="int?" @bind-Value="mainPage.PriceToKopeks" />
                        <small class="admin-muted">Если пусто — показывается только цена «от».</small>
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="mainDelivery" @bind="mainPage.IsDeliveryPriceMode" />
                        <label class="form-check-label" for="mainDelivery">Цена зависит от способа вывоза</label>
                    </div>

                    <h2 class="admin-card-title mt-4">Окно выбора города</h2>
                    <div class="form-check form-switch mb-2 admin-switch">
                        <input class="form-check-input" type="checkbox" id="mainSelector" @bind="mainPage.IsCitySelectorEnabled" />
                        <label class="form-check-label" for="mainSelector">Показывать при открытии сайта</label>
                    </div>
                    <div class="form-check form-switch mb-3 admin-switch">
                        <input class="form-check-input" type="checkbox" id="mainRemember" @bind="mainPage.IsRememberCityEnabled" />
                        <label class="form-check-label" for="mainRemember">Запоминать выбор: при повторном визите сразу открывать город</label>
                    </div>
                    <div class="mb-3">
                        <label class="admin-label">Заголовок окна</label>
                        <input class="form-control" @bind="mainPage.CitySelectorTitle" maxlength="160" placeholder="Выберите ваш город" />
                    </div>
                    <div class="mb-3">
                        <label class="admin-label">Текст окна</label>
                        <textarea class="form-control" rows="2" @bind="mainPage.CitySelectorText" maxlength="400"></textarea>
                    </div>

                    <button class="admin-btn admin-btn-primary w-100" @onclick="SaveMainPageAsync" disabled="@saving">
                        @(saving ? "Сохранение..." : "Сохранить главную страницу")
                    </button>
                    @StatusMessage(mainMessage, mainError)
                </div>
            </div>

            <div class="col-lg-4">
                <div class="admin-card">
                    <h2 class="admin-card-title">Общее промо</h2>
                    <p class="admin-muted">Всплывающее сообщение для общей страницы сайта.</p>
                    @PromoFields(globalPromo, "globalPromo")
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="globalOnCities" @bind="mainPage.IsGlobalPromoShownOnCityPages" />
                        <label class="form-check-label" for="globalOnCities">Показывать и на страницах городов, у которых нет своего промо</label>
                    </div>
                    <button class="admin-btn admin-btn-primary w-100" @onclick="SaveGlobalPromoAsync" disabled="@saving">
                        @(saving ? "Сохранение..." : "Сохранить промо")
                    </button>
                    @StatusMessage(globalPromoMessage, globalPromoError)
                </div>
            </div>
        </div>
    };

    private async Task SaveMainPageAsync()
    {
        mainMessage = null; mainError = false;
        if (string.IsNullOrWhiteSpace(mainPage.Title)) { mainMessage = "Укажите Title страницы."; mainError = true; return; }
        if (mainPage.Price is < 0 || mainPage.PriceToKopeks is < 0) { mainMessage = "Цена не может быть отрицательной."; mainError = true; return; }

        saving = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            mainPage.UpdatedAt = DateTime.Now;
            if (mainPage.Id == 0) db.MainPageSettings.Add(mainPage);
            else db.MainPageSettings.Update(mainPage);
            await db.SaveChangesAsync();
            mainMessage = "Сохранено.";
        }
        catch (Exception ex)
        {
            mainMessage = "Ошибка сохранения: " + ex.GetBaseException().Message; mainError = true;
        }
        finally
        {
            saving = false;
        }
    }

    private async Task SaveGlobalPromoAsync()
    {
        globalPromoMessage = null; globalPromoError = false;
        if (globalPromo.IsActive && (string.IsNullOrWhiteSpace(globalPromo.Title) || string.IsNullOrWhiteSpace(globalPromo.Text)))
        {
            globalPromoMessage = "Для активного промо заполните заголовок и текст."; globalPromoError = true;
            return;
        }

        saving = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            globalPromo.CityId = null;
            globalPromo.Title = string.IsNullOrWhiteSpace(globalPromo.Title) ? "Внимание!" : globalPromo.Title.Trim();
            globalPromo.Text ??= "";
            if (globalPromo.Id == 0) db.PromoMessages.Add(globalPromo);
            else db.PromoMessages.Update(globalPromo);

            // Галочка «показывать на страницах городов» хранится в настройках страницы — сохраняем только её.
            var settings = await db.MainPageSettings.OrderBy(m => m.Id).FirstOrDefaultAsync();
            if (settings is not null)
            {
                settings.IsGlobalPromoShownOnCityPages = mainPage.IsGlobalPromoShownOnCityPages;
                settings.UpdatedAt = DateTime.Now;
            }

            await db.SaveChangesAsync();
            globalPromoMessage = "Промо сохранено.";
        }
        catch (Exception ex)
        {
            globalPromoMessage = "Ошибка сохранения: " + ex.GetBaseException().Message; globalPromoError = true;
        }
        finally
        {
            saving = false;
        }
    }

    // =====================================================================
    // USERS
    // =====================================================================

    private List<AdminUser> users = new();

    private string? pwdCurrent, pwdNew, pwdConfirm;
    private string? pwdMessage; private bool pwdError;

    private string? newLogin, newDisplayName, newPassword;
    private string newRole = AdminRoles.Driver;
    private string? newUserMessage; private bool newUserError;

    private long resetUserId;
    private string? resetPassword;
    private string? usersMessage; private bool usersError;

    private async Task LoadUsersAsync(AppDBContext db)
    {
        users = await db.AdminUsers.AsNoTracking().OrderBy(u => u.Login).ToListAsync();
    }

    private RenderFragment UsersTab() => __builder =>
    {
        <div class="row g-3">
            <div class="col-lg-4">
                <div class="admin-card">
                    <h2 class="admin-card-title">Сменить мой пароль</h2>
                    <div class="mb-3">
                        <label class="admin-label">Текущий пароль</label>
                        <input class="form-control" type="password" autocomplete="current-password" @bind="pwdCurrent" />
                    </div>
                    <div class="mb-3">
                        <label class="admin-label">Новый пароль</label>
                        <input class="form-control" type="password" autocomplete="new-password" @bind="pwdNew" />
                        <small class="admin-muted">Не короче @AdminAuthService.MinPasswordLength символов, буквы и цифры.</small>
                    </div>
                    <div class="mb-3">
                        <label class="admin-label">Повторите новый пароль</label>
                        <input class="form-control" type="password" autocomplete="new-password" @bind="pwdConfirm" />
                    </div>
                    <button class="admin-btn admin-btn-primary w-100" @onclick="ChangeOwnPasswordAsync" disabled="@saving">Сменить пароль</button>
                    @StatusMessage(pwdMessage, pwdError)
                    <small class="admin-muted d-block mt-2">После смены пароля все сессии (в том числе на других устройствах) будут завершены — войдите заново.</small>
                </div>
            </div>

            <div class="col-lg-8">
                <div class="admin-card mb-3">
                    <h2 class="admin-card-title">Пользователи панели</h2>
                    <div class="table-responsive">
                        <table class="table align-middle admin-table mb-0">
                            <thead><tr><th>Логин</th><th>Имя</th><th>Роль</th><th>Последний вход</th><th>Статус</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var u in users)
                                {
                                    var isMe = u.Id == currentUserId;
                                    <tr>
                                        <td><strong>@u.Login</strong> @if (isMe) { <span class="admin-badge admin-badge-on">это вы</span> }</td>
                                        <td>@u.DisplayName</td>
                                        <td><span class="admin-badge @(u.Role == AdminRoles.Driver ? "admin-badge-warn" : "admin-badge-on")">@AdminRoles.Title(u.Role)</span></td>
                                        <td class="text-nowrap">@(u.LastLoginAt?.ToString("dd.MM.yyyy HH:mm") ?? "—")</td>
                                        <td>
                                            @if (!u.IsActive) { <span class="admin-badge admin-badge-off">отключён</span> }
                                            else if (u.LockoutUntil > DateTime.Now) { <span class="admin-badge admin-badge-warn">заблокирован до @u.LockoutUntil?.ToString("HH:mm")</span> }
                                            else { <span class="admin-badge admin-badge-on">активен</span> }
                                        </td>
                                        <td class="text-end text-nowrap">
                                            <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => StartEditUser(u)">Изменить</button>
                                            @if (!isMe)
                                            {
                                                <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => ToggleRoleAsync(u.Id)">
                                                    @(u.Role == AdminRoles.Driver ? "Сделать админом" : "Сделать водителем")
                                                </button>
                                                <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => { resetUserId = u.Id; resetPassword = null; usersMessage = null; }">Новый пароль</button>
                                                <button class="btn btn-sm @(u.IsActive ? "btn-outline-danger" : "btn-outline-success")" @onclick="() => ToggleUserActiveAsync(u.Id)">
                                                    @(u.IsActive ? "Отключить" : "Включить")
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                    @if (editUserId == u.Id)
                                    {
                                        <tr class="admin-row-edit">
                                            <td colspan="6">
                                                <div class="row g-2 align-items-end">
                                                    <div class="col-sm-6 col-lg-3">
                                                        <label class="admin-label">Логин</label>
                                                        <input class="form-control" autocomplete="off" @bind="editLogin" disabled="@isMe" />
                                                    </div>
                                                    <div class="col-sm-6 col-lg-3">
                                                        <label class="admin-label">Имя (видно в заявках и маршрутах)</label>
                                                        <input class="form-control" maxlength="100" @bind="editDisplayName" />
                                                    </div>
                                                    <div class="col-sm-6 col-lg-3">
                                                        <label class="admin-label">Роль</label>
                                                        <select class="form-select" @bind="editRole" disabled="@isMe">
                                                            <option value="@AdminRoles.Admin">Администратор</option>
                                                            <option value="@AdminRoles.Driver">Водитель</option>
                                                        </select>
                                                    </div>
                                                    <div class="col-sm-6 col-lg-3 d-flex gap-2 flex-wrap">
                                                        <button class="btn btn-success" disabled="@saving" @onclick="SaveUserAsync">Сохранить</button>
                                                        <button class="btn btn-link" @onclick="() => editUserId = 0">Отмена</button>
                                                    </div>
                                                    @if (!isMe && u.LockoutUntil > DateTime.Now)
                                                    {
                                                        <div class="col-12">
                                                            <div class="form-check">
                                                                <input class="form-check-input" type="checkbox" id="unlockUser" @bind="editUnlock" />
                                                                <label class="form-check-label" for="unlockUser">Снять блокировку за неверные пароли</label>
                                                            </div>
                                                        </div>
                                                    }
                                                    @if (isMe) { <div class="col-12 admin-muted small">Свой логин и роль изменить нельзя — только имя.</div> }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                    @if (resetUserId == u.Id)
                                    {
                                        <tr class="admin-row-edit">
                                            <td colspan="6">
                                                <div class="d-flex gap-2 flex-wrap align-items-center">
                                                    <span>Новый пароль для <strong>@u.Login</strong>:</span>
                                                    <input class="form-control w-auto" type="password" autocomplete="new-password" @bind="resetPassword" />
                                                    <button class="btn btn-sm btn-success" @onclick="ResetUserPasswordAsync">Сохранить</button>
                                                    <button class="btn btn-sm btn-link" @onclick="() => resetUserId = 0">Отмена</button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                    @StatusMessage(usersMessage, usersError)
                </div>

                <div class="admin-card">
                    <h2 class="admin-card-title">Добавить пользователя</h2>
                    <div class="row g-2">
                        <div class="col-md-4">
                            <label class="admin-label">Логин</label>
                            <input class="form-control" autocomplete="off" @bind="newLogin" />
                        </div>
                        <div class="col-md-4">
                            <label class="admin-label">Имя</label>
                            <input class="form-control" autocomplete="off" @bind="newDisplayName" />
                        </div>
                        <div class="col-md-4">
                            <label class="admin-label">Пароль</label>
                            <input class="form-control" type="password" autocomplete="new-password" @bind="newPassword" />
                        </div>
                        <div class="col-md-4">
                            <label class="admin-label">Роль</label>
                            <select class="form-select" @bind="newRole">
                                <option value="@AdminRoles.Driver">Водитель — только заявки</option>
                                <option value="@AdminRoles.Admin">Администратор — вся панель</option>
                            </select>
                        </div>
                    </div>
                    <small class="admin-muted d-block mt-2">Водитель входит по тому же адресу /admin/login и видит только страницу заявок: отработка, отмена, возврат, сумма выплаты и комментарий.</small>
                    <button class="admin-btn admin-btn-primary mt-3" @onclick="CreateUserAsync" disabled="@saving"><i class="fa-solid fa-user-plus"></i> Добавить</button>
                    @StatusMessage(newUserMessage, newUserError)
                </div>
            </div>
</div>
    };

    private async Task ChangeOwnPasswordAsync()
    {
        pwdMessage = null; pwdError = false;

        if (pwdNew != pwdConfirm) { pwdMessage = "Новые пароли не совпадают."; pwdError = true; return; }
        var weak = AdminAuthService.ValidatePasswordStrength(pwdNew);
        if (weak is not null) { pwdMessage = weak; pwdError = true; return; }

        saving = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var me = await db.AdminUsers.FirstOrDefaultAsync(u => u.Id == currentUserId);
            if (me is null) { pwdMessage = "Пользователь не найден."; pwdError = true; return; }
            if (string.IsNullOrEmpty(pwdCurrent) || !Auth.VerifyPassword(me, pwdCurrent)) { pwdMessage = "Текущий пароль указан неверно."; pwdError = true; return; }
            if (pwdCurrent == pwdNew) { pwdMessage = "Новый пароль должен отличаться от текущего."; pwdError = true; return; }

            me.PasswordHash = Auth.HashPassword(me, pwdNew!);
            me.SecurityStamp = Guid.NewGuid().ToString("N");
            me.MustChangePassword = false;
            await db.SaveChangesAsync();
        }
        finally
        {
            saving = false;
            pwdCurrent = pwdNew = pwdConfirm = null;
        }

        // Метка безопасности сменилась — текущая cookie больше недействительна, нужен повторный вход.
        Nav.NavigateTo("/admin/login?returnUrl=%2Fadminpanel", forceLoad: true);
    }

    private async Task CreateUserAsync()
    {
        newUserMessage = null; newUserError = false;
        var login = AdminAuthService.NormalizeLogin(newLogin);

        if (!Regex.IsMatch(login, "^[a-z0-9._-]{3,64}$")) { newUserMessage = "Логин: 3–64 символа, латиница, цифры, точка, дефис, подчёркивание."; newUserError = true; return; }
        var weak = AdminAuthService.ValidatePasswordStrength(newPassword);
        if (weak is not null) { newUserMessage = weak; newUserError = true; return; }

        saving = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            if (await db.AdminUsers.AnyAsync(u => u.Login == login)) { newUserMessage = "Такой логин уже есть."; newUserError = true; return; }

            var user = new AdminUser
            {
                Login = login,
                DisplayName = string.IsNullOrWhiteSpace(newDisplayName) ? null : newDisplayName.Trim(),
                IsActive = true,
                Role = newRole == AdminRoles.Admin ? AdminRoles.Admin : AdminRoles.Driver,
                PasswordHash = ""
            };
            user.PasswordHash = Auth.HashPassword(user, newPassword!);
            db.AdminUsers.Add(user);
            await db.SaveChangesAsync();
            await LoadUsersAsync(db);

            newLogin = newDisplayName = newPassword = null;
            newUserMessage = $"{AdminRoles.Title(user.Role)} «{login}» добавлен.";
        }
        finally
        {
            saving = false;
        }
    }

    private long editUserId;
    private string? editLogin, editDisplayName;
    private string editRole = AdminRoles.Driver;
    private bool editUnlock;

    private void StartEditUser(AdminUser u)
    {
        usersMessage = null; usersError = false;
        resetUserId = 0;
        editUserId = u.Id;
        editLogin = u.Login;
        editDisplayName = u.DisplayName;
        editRole = u.Role;
        editUnlock = false;
    }

    private async Task SaveUserAsync()
    {
        usersMessage = null; usersError = false;
        var isMe = editUserId == currentUserId;
        saving = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var user = await db.AdminUsers.FirstOrDefaultAsync(u => u.Id == editUserId);
            if (user is null) { editUserId = 0; return; }

            var login = AdminAuthService.NormalizeLogin(editLogin);
            var role = editRole == AdminRoles.Admin ? AdminRoles.Admin : AdminRoles.Driver;
            var sessionsReset = false;
            if (!isMe)
            {
                if (!Regex.IsMatch(login, "^[a-z0-9._-]{3,64}$")) { usersMessage = "Логин: 3–64 символа, латиница, цифры, точка, дефис, подчёркивание."; usersError = true; return; }
                if (login != user.Login && await db.AdminUsers.AnyAsync(u => u.Login == login && u.Id != user.Id)) { usersMessage = "Такой логин уже есть."; usersError = true; return; }
                if (role == AdminRoles.Driver && user.Role == AdminRoles.Admin && user.IsActive &&
                    await db.AdminUsers.CountAsync(u => u.IsActive && u.Role == AdminRoles.Admin) <= 1)
                { usersMessage = "Нельзя понизить последнего активного администратора."; usersError = true; return; }

                sessionsReset = login != user.Login || role != user.Role;
                user.Login = login;
                user.Role = role;
                if (editUnlock) { user.LockoutUntil = null; user.FailedLoginCount = 0; }
                if (sessionsReset) user.SecurityStamp = Guid.NewGuid().ToString("N"); // новые логин/роль — после повторного входа
            }
            user.DisplayName = string.IsNullOrWhiteSpace(editDisplayName) ? null : editDisplayName.Trim();
            await db.SaveChangesAsync();
            await LoadUsersAsync(db);
            if (isMe) currentUserDisplay = user.DisplayName ?? user.Login;
            editUserId = 0;
            usersMessage = $"Пользователь «{user.Login}» сохранён." + (sessionsReset ? " Его текущие сессии завершены — нужно войти заново." : "");
        }
        finally { saving = false; }
    }

    private async Task ToggleRoleAsync(long userId)
    {
        usersMessage = null; usersError = false;
        if (userId == currentUserId) return;

        await using var db = await DbFactory.CreateDbContextAsync();
        var user = await db.AdminUsers.FirstOrDefaultAsync(u => u.Id == userId);
        if (user is null) return;

        var toDriver = user.Role != AdminRoles.Driver;
        if (toDriver && user.IsActive &&
            await db.AdminUsers.CountAsync(u => u.IsActive && u.Role == AdminRoles.Admin) <= 1)
        {
            usersMessage = "Нельзя понизить последнего активного администратора."; usersError = true;
            return;
        }

        user.Role = toDriver ? AdminRoles.Driver : AdminRoles.Admin;
        user.SecurityStamp = Guid.NewGuid().ToString("N"); // новая роль применится после повторного входа
        await db.SaveChangesAsync();
        await LoadUsersAsync(db);
        usersMessage = $"«{user.Login}» теперь {AdminRoles.Title(user.Role).ToLowerInvariant()}. Его текущие сессии завершены.";
    }

    private async Task ToggleUserActiveAsync(long userId)
    {
        usersMessage = null; usersError = false;
        if (userId == currentUserId) return;

        await using var db = await DbFactory.CreateDbContextAsync();
        var user = await db.AdminUsers.FirstOrDefaultAsync(u => u.Id == userId);
        if (user is null) return;

        if (user.IsActive && user.Role == AdminRoles.Admin &&
            await db.AdminUsers.CountAsync(u => u.IsActive && u.Role == AdminRoles.Admin) <= 1)
        {
            usersMessage = "Нельзя отключить последнего активного администратора."; usersError = true;
            return;
        }

        user.IsActive = !user.IsActive;
        user.SecurityStamp = Guid.NewGuid().ToString("N"); // завершаем его активные сессии
        if (user.IsActive) { user.LockoutUntil = null; user.FailedLoginCount = 0; }
        await db.SaveChangesAsync();
        await LoadUsersAsync(db);
        usersMessage = user.IsActive ? $"«{user.Login}» включён." : $"«{user.Login}» отключён, его сессии завершены.";
    }

    private async Task ResetUserPasswordAsync()
    {
        usersMessage = null; usersError = false;
        var weak = AdminAuthService.ValidatePasswordStrength(resetPassword);
        if (weak is not null) { usersMessage = weak; usersError = true; return; }

        await using var db = await DbFactory.CreateDbContextAsync();
        var user = await db.AdminUsers.FirstOrDefaultAsync(u => u.Id == resetUserId);
        if (user is null || user.Id == currentUserId) return;

        user.PasswordHash = Auth.HashPassword(user, resetPassword!);
        user.SecurityStamp = Guid.NewGuid().ToString("N");
        user.MustChangePassword = true;
        user.LockoutUntil = null;
        user.FailedLoginCount = 0;
        await db.SaveChangesAsync();
        await LoadUsersAsync(db);

        usersMessage = $"Пароль для «{user.Login}» изменён. При входе ему будет предложено сменить пароль.";
        resetUserId = 0;
        resetPassword = null;
    }
}
