@page "/adminpanel"
@page "/admin"
@attribute [Authorize]
@rendermode InteractiveServer

@using System.Security.Claims
@using System.Text.RegularExpressions
@using EcobayApp.Contex
@using EcobayApp.Models
@using EcobayApp.Services
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDBContext> DbFactory
@inject AdminAuthService Auth
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Панель управления | Ecobay.by</PageTitle>
<HeadContent>
    <meta name="robots" content="noindex, nofollow" />
</HeadContent>

<div class="admin-shell">
    <header class="admin-topbar">
        <div class="container d-flex align-items-center justify-content-between gap-3 flex-wrap">
            <a class="admin-brand text-decoration-none" href="/adminpanel">
                <img src="images/hero/icon.png" alt="" />Ecobay<span>.by</span>
                <small>панель управления</small>
            </a>
            <div class="d-flex align-items-center gap-3 flex-wrap">
                <a class="admin-link" href="/?all=1" target="_blank"><i class="fa-solid fa-arrow-up-right-from-square"></i> Открыть сайт</a>
                <span class="admin-user"><i class="fa-solid fa-user-shield"></i> @currentUserDisplay</span>
                <form method="post" action="/admin/logout" class="m-0">
                    <AntiforgeryToken />
                    <button type="submit" class="admin-btn admin-btn-ghost">Выйти</button>
                </form>
            </div>
        </div>
    </header>

    <div class="container my-4">
        @if (mustChangePassword)
        {
            <div class="admin-alert admin-alert-warn mb-3">
                <strong>Смените пароль.</strong> Вы вошли с паролем из файла конфигурации. Задайте свой пароль во вкладке «Пользователи».
            </div>
        }

        <ul class="admin-tabs">
            <li><button class="@(activeTab == AdminTab.Dashboard ? "active" : "")" @onclick="() => SetTab(AdminTab.Dashboard)"><i class="fa-solid fa-chart-line"></i> Дашборд</button></li>
            <li><button class="@(activeTab == AdminTab.Requests ? "active" : "")" @onclick="() => OpenRequests(false)"><i class="fa-solid fa-inbox"></i> Заявки</button></li>
            <li><button class="@(activeTab == AdminTab.Goals ? "active" : "")" @onclick="() => SetTab(AdminTab.Goals)"><i class="fa-solid fa-bullseye"></i> Цели</button></li>
            <li><button class="@(activeTab == AdminTab.Cities ? "active" : "")" @onclick="() => SetTab(AdminTab.Cities)"><i class="fa-solid fa-city"></i> Города</button></li>
            <li><button class="@(activeTab == AdminTab.MainPage ? "active" : "")" @onclick="() => SetTab(AdminTab.MainPage)"><i class="fa-solid fa-flag"></i> Главная сайта</button></li>
            <li><button class="@(activeTab == AdminTab.Users ? "active" : "")" @onclick="() => SetTab(AdminTab.Users)"><i class="fa-solid fa-users-gear"></i> Пользователи</button></li>
        </ul>

        @switch (activeTab)
        {
            case AdminTab.Dashboard:
                <AdminDashboard OnRequests="() => OpenRequests(true)" OnGoals="() => SetTab(AdminTab.Goals)" />
                break;
            case AdminTab.Requests:
                <AdminRequests TodayOnly="requestsTodayOnly" />
                break;
            case AdminTab.Goals:
                <AdminGoals />
                break;
            case AdminTab.Cities:
                @CitiesTab()
                break;
            case AdminTab.MainPage:
                @MainPageTab()
                break;
            case AdminTab.Users:
                @UsersTab()
                break;
        }
    </div>
</div>

@code {
    private enum AdminTab { Dashboard, Requests, Goals, Cities, MainPage, Users }

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private AdminTab activeTab = AdminTab.Dashboard;
    private long currentUserId;
    private string currentUserDisplay = "";
    private bool mustChangePassword;
    private bool requestsTodayOnly;

    private static readonly Regex SlugRegex = new("^[a-z0-9]+(?:-[a-z0-9]+)*$", RegexOptions.Compiled);

    /// <summary>Адреса, которые заняты страницами сайта и не могут быть slug города.</summary>
    private static readonly HashSet<string> ReservedSlugs = new(StringComparer.OrdinalIgnoreCase)
    {
        "admin", "adminpanel", "contacts", "user-agreement", "error", "login", "logout",
        "css", "js", "images", "font", "bootstrap", "_framework", "_blazor"
    };

    private void SetTab(AdminTab tab) => activeTab = tab;

    private void OpenRequests(bool todayOnly)
    {
        requestsTodayOnly = todayOnly;
        activeTab = AdminTab.Requests;
    }

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var user = (await AuthState).User;
            long.TryParse(user.FindFirstValue(ClaimTypes.NameIdentifier), out currentUserId);
            currentUserDisplay = user.FindFirstValue("ecobay:display") ?? user.Identity?.Name ?? "";
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var me = await db.AdminUsers.AsNoTracking().FirstOrDefaultAsync(u => u.Id == currentUserId);
        mustChangePassword = me?.MustChangePassword == true;
        if (mustChangePassword)
            activeTab = AdminTab.Users;

        await LoadCitiesAsync(db);
        await LoadMainPageAsync(db);
        await LoadUsersAsync(db);
    }

    // =====================================================================
    // CITIES
    // =====================================================================

    private List<CityRow> cities = new();
    private City? editCity;
    private PageCity? editPage;
    private PromoMessage? editPromo;

    private string? cityMessage; private bool cityError;
    private string? pageMessage; private bool pageError;
    private string? promoMessage; private bool promoError;
    private bool saving;

    private sealed record CityRow(long Id, string Name, string Slug, bool IsActive, int SortOrder, bool HasPage);

    private async Task LoadCitiesAsync(AppDBContext db)
    {
        cities = await db.Cities.AsNoTracking()
            .OrderBy(c => c.SortOrder).ThenBy(c => c.Name)
            .Select(c => new CityRow(c.Id, c.Name, c.Slug, c.IsActive, c.SortOrder, c.Pages.Any()))
            .ToListAsync();
    }

    private int ActiveCitiesOnSite => cities.Count(c => c.IsActive && c.HasPage);

    private RenderFragment CitiesTab() => __builder =>
    {
        <div class="admin-hint mb-3">
            <i class="fa-solid fa-circle-info"></i>
            В окне выбора города на сайте показываются только <strong>активные</strong> города с сохранённой страницей.
            Сейчас на сайте: <strong>@ActiveCitiesOnSite</strong> из @cities.Count.
            Неактивный город скрыт со всего сайта, его адрес перенаправляет на страницу «Вся Беларусь».
        </div>

        <div class="row g-3">
            <div class="col-lg-3">
                <div class="admin-card">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h2 class="admin-card-title mb-0">Города</h2>
                        <button class="admin-btn admin-btn-primary admin-btn-sm" @onclick="CreateNewCity"><i class="fa-solid fa-plus"></i> Добавить</button>
                    </div>
                    <ul class="admin-city-list">
                        @foreach (var c in cities)
                        {
                            <li class="@(editCity?.Id == c.Id && c.Id != 0 ? "selected" : "")" @onclick="() => SelectCityAsync(c.Id)">
                                <div>
                                    <strong>@c.Name</strong>
                                    <small>/@c.Slug</small>
                                </div>
                                @if (!c.IsActive)
                                {
                                    <span class="admin-badge admin-badge-off">выключен</span>
                                }
                                else if (!c.HasPage)
                                {
                                    <span class="admin-badge admin-badge-warn">нет страницы</span>
                                }
                                else
                                {
                                    <span class="admin-badge admin-badge-on">на сайте</span>
                                }
                            </li>
                        }
                    </ul>
                </div>
            </div>

            <div class="col-lg-3">
                <div class="admin-card">
                    <h2 class="admin-card-title">Город</h2>
                    @if (editCity is null)
                    {
                        <p class="admin-muted">Выберите город слева или создайте новый.</p>
                    }
                    else
                    {
                        <div class="form-check form-switch mb-3 admin-switch">
                            <input class="form-check-input" type="checkbox" id="cityActive" @bind="editCity.IsActive" />
                            <label class="form-check-label" for="cityActive">Город активен (виден на сайте)</label>
                        </div>
                        <div class="mb-3">
                            <label class="admin-label">Название (именительный падеж)</label>
                            <input class="form-control" @bind="editCity.Name" placeholder="Гомель" />
                        </div>
                        <div class="mb-3">
                            <label class="admin-label">Название в предложном падеже</label>
                            <input class="form-control" @bind="editCity.NameIn" placeholder="Гомеле" />
                            <small class="admin-muted">Используется во фразах «в Гомеле».</small>
                        </div>
                        <div class="mb-3">
                            <label class="admin-label">Slug (адрес страницы)</label>
                            <div class="input-group">
                                <span class="input-group-text">ecobay.by/</span>
                                <input class="form-control" @bind="editCity.Slug" placeholder="gomel" />
                            </div>
                            <small class="admin-muted">Латиница в нижнем регистре, цифры и дефис.</small>
                        </div>
                        <div class="mb-3">
                            <label class="admin-label">Порядок в списке</label>
                            <input class="form-control" type="number" @bind="editCity.SortOrder" />
                            <small class="admin-muted">Меньше — выше. При равенстве — по алфавиту.</small>
                        </div>
                        <div class="mb-3">
                            <label class="admin-label">Телефон по умолчанию</label>
                            <input class="form-control" @bind="editCity.DefaultPhone" />
                        </div>
                        <div class="mb-3">
                            <label class="admin-label">Цена по умолчанию (коп./кг)</label>
                            <InputNumber class="form-control" TValue="decimal?" @bind-Value="editCity.DefaultPrice" />
                        </div>

                        <button class="admin-btn admin-btn-primary w-100" @onclick="SaveCityAsync" disabled="@saving">
                            @(saving ? "Сохранение..." : "Сохранить город")
                        </button>
                        @StatusMessage(cityMessage, cityError)
                        @if (editCity.Id != 0 && editCity.IsActive)
                        {
                            <a class="admin-link d-block mt-3" href="@($"/{editCity.Slug}")" target="_blank"><i class="fa-solid fa-arrow-up-right-from-square"></i> Открыть страницу города</a>
                        }
                    }
                </div>
            </div>

            <div class="col-lg-3">
                <div class="admin-card">
                    <h2 class="admin-card-title">Страница города</h2>
                    @if (editPage is null)
                    {
                        <p class="admin-muted">Сначала сохраните город — страница создастся автоматически.</p>
                    }
                    else
                    {
                        @PageFields()
                        <button class="admin-btn admin-btn-primary w-100" @onclick="SavePageAsync" disabled="@saving">
                            @(saving ? "Сохранение..." : "Сохранить страницу")
                        </button>
                        @StatusMessage(pageMessage, pageError)
                    }
                </div>
            </div>

            <div class="col-lg-3">
                <div class="admin-card">
                    <h2 class="admin-card-title">Промо для города</h2>
                    @if (editPromo is null)
                    {
                        <p class="admin-muted">Выберите сохранённый город — можно будет настроить всплывающее сообщение.</p>
                    }
                    else
                    {
                        @PromoFields(editPromo, "cityPromo")
                        <button class="admin-btn admin-btn-primary w-100" @onclick="SavePromoAsync" disabled="@saving">
                            @(saving ? "Сохранение..." : "Сохранить промо")
                        </button>
                        @StatusMessage(promoMessage, promoError)
                    }
                </div>
            </div>
        </div>
    };

    private RenderFragment PageFields() => __builder =>
    {
        <div class="mb-3">
            <label class="admin-label">Title страницы</label>
            <input class="form-control" @bind="editPage!.Title" />
        </div>
        <div class="mb-3">
            <label class="admin-label">Описание (meta description)</label>
            <textarea class="form-control" rows="3" @bind="editPage!.Description"></textarea>
        </div>
        <div class="mb-3">
            <label class="admin-label">Ключевые слова (meta keywords)</label>
            <textarea class="form-control" rows="2" @bind="editPage!.KeyWords"></textarea>
        </div>
        <div class="mb-3">
            <label class="admin-label">Телефон для страницы</label>
            <input class="form-control" @bind="editPage!.PhoneCity" />
            <small class="admin-muted">Если пусто — телефон города (@(string.IsNullOrWhiteSpace(editCity?.DefaultPhone) ? "не указан" : editCity!.DefaultPhone)).</small>
        </div>
        <details class="admin-local-editor mb-3">
            <summary>Уникальное содержание города</summary>
            <p class="admin-muted mt-2">Пишите реальные местные условия, а не тот же текст с заменой города. Пустые блоки на сайте не выводятся.</p>
            <label class="admin-label">Заголовок первого экрана</label>
            <input class="form-control mb-3" maxlength="200" @bind="editPage!.HeroTitle" placeholder="Свой H1 для города (необязательно)" />
            <label class="admin-label">О работе в этом городе</label>
            <textarea class="form-control mb-3" rows="4" maxlength="1500" @bind="editPage!.LocalIntro"
                      placeholder="Что полезно знать местному клиенту, какие заявки вывозите, особенности работы."></textarea>
            <label class="admin-label">Город и его район: зона обслуживания</label>
            <textarea class="form-control mb-3" rows="4" maxlength="1500" @bind="editPage!.CoverageText"
                      placeholder="Конкретные населённые пункты района, которые вы действительно обслуживаете."></textarea>
            <label class="admin-label">Условия и порядок вывоза</label>
            <textarea class="form-control mb-3" rows="4" maxlength="1500" @bind="editPage!.PickupDetails"
                      placeholder="Как согласовать выезд в район, что подготовить, реальный график и условия самопривоза."></textarea>
        </details>
        <div class="mb-3">
            <label class="admin-label">Цена ОТ (коп./кг)</label>
            <InputNumber class="form-control" TValue="decimal?" @bind-Value="editPage!.Price" />
            <small class="admin-muted">Если пусто — цена города (@(editCity?.DefaultPrice?.ToString() ?? "не указана")).</small>
        </div>
        <div class="mb-3">
            <label class="admin-label">Цена ДО (коп./кг)</label>
            <InputNumber class="form-control" TValue="int?" @bind-Value="editPage!.PriceToKopeks" />
            <small class="admin-muted">Если пусто — показывается только цена «от».</small>
        </div>
        <div class="form-check mb-3">
            <input class="form-check-input" type="checkbox" id="deliveryPriceModeCheck" @bind="editPage!.IsDeliveryPriceMode" />
            <label class="form-check-label" for="deliveryPriceModeCheck">Цена зависит от способа вывоза</label>
            <small class="admin-muted d-block mt-1">«От» — мы приезжаем и вывозим. «До» — клиент сам привозит в передвижной пункт.</small>
        </div>
    };

    private RenderFragment PromoFields(PromoMessage promo, string idPrefix) => __builder =>
    {
        <div class="form-check form-switch mb-3 admin-switch">
            <input class="form-check-input" type="checkbox" id="@(idPrefix + "Active")" @bind="promo.IsActive" />
            <label class="form-check-label" for="@(idPrefix + "Active")">Показывать промо</label>
        </div>
        <div class="mb-3">
            <label class="admin-label">Заголовок</label>
            <input class="form-control" @bind="promo.Title" maxlength="160" />
        </div>
        <div class="mb-3">
            <label class="admin-label">Текст</label>
            <textarea class="form-control" rows="4" @bind="promo.Text" maxlength="500"></textarea>
        </div>
    };

    private static RenderFragment StatusMessage(string? message, bool isError) => __builder =>
    {
        if (!string.IsNullOrEmpty(message))
        {
            <p class="@(isError ? "admin-status-error" : "admin-status-ok") mt-2 mb-0">@message</p>
        }
    };

    private void ResetCityMessages()
    {
        cityMessage = pageMessage = promoMessage = null;
        cityError = pageError = promoError = false;
    }

    private void CreateNewCity()
    {
        ResetCityMessages();
        editCity = new City
        {
            Name = "",
            NameIn = "",
            Slug = "",
            DefaultPhone = DbSeeder.DefaultPhone,
            DefaultPrice = 20m,
            IsActive = true,
            SortOrder = cities.Count == 0 ? 0 : cities.Max(c => c.SortOrder)
        };
        editPage = null;
        editPromo = null;
    }

    private async Task SelectCityAsync(long cityId)
    {
        ResetCityMessages();

        await using var db = await DbFactory.CreateDbContextAsync();
        editCity = await db.Cities.AsNoTracking().FirstOrDefaultAsync(c => c.Id == cityId);
        if (editCity is null)
        {
            editPage = null;
            editPromo = null;
            return;
        }

        editPage = await db.PageCities.AsNoTracking().FirstOrDefaultAsync(p => p.CityId == cityId)
                   ?? NewPageFor(editCity);

        editPromo = await db.PromoMessages.AsNoTracking().FirstOrDefaultAsync(p => p.CityId == cityId)
                    ?? new PromoMessage { CityId = editCity.Id, Title = $"Акция в {editCity.NameIn}", Text = "", IsActive = false };
    }

    private static PageCity NewPageFor(City city) => new()
    {
        CityId = city.Id,
        Title = $"Вывоз бытовой техники в {city.NameIn}",
        Description = $"Быстрый и выгодный вывоз бытовой техники в {city.NameIn}.",
        KeyWords = $"вывоз техники {city.Name}, утилизация техники {city.Name}, приём техники {city.Name}",
        Price = city.DefaultPrice ?? 20m,
        PhoneCity = city.DefaultPhone
    };

    private async Task<string?> ValidateCityAsync(AppDBContext db, City city)
    {
        city.Name = city.Name?.Trim() ?? "";
        city.NameIn = city.NameIn?.Trim() ?? "";
        city.Slug = (city.Slug ?? "").Trim().ToLowerInvariant();
        city.DefaultPhone = string.IsNullOrWhiteSpace(city.DefaultPhone) ? null : city.DefaultPhone.Trim();

        if (city.Name.Length == 0) return "Укажите название города.";
        if (city.NameIn.Length == 0) return "Укажите название в предложном падеже (например, «Гомеле»).";
        if (city.Slug.Length == 0) return "Укажите slug.";
        if (!SlugRegex.IsMatch(city.Slug)) return "Slug: только латиница a–z, цифры и дефис (например, «gomel» или «novaya-guta»).";
        if (ReservedSlugs.Contains(city.Slug)) return $"Адрес «{city.Slug}» зарезервирован сайтом, выберите другой.";
        if (await db.Cities.AnyAsync(c => c.Slug == city.Slug && c.Id != city.Id)) return $"Город с адресом «{city.Slug}» уже существует.";
        if (city.DefaultPrice is < 0) return "Цена не может быть отрицательной.";
        return null;
    }

    private async Task SaveCityAsync()
    {
        if (editCity is null) return;
        ResetCityMessages();
        saving = true;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            var error = await ValidateCityAsync(db, editCity);
            if (error is not null)
            {
                cityMessage = error; cityError = true;
                return;
            }

            var isNew = editCity.Id == 0;
            if (isNew) db.Cities.Add(editCity);
            else db.Cities.Update(editCity);
            await db.SaveChangesAsync();

            // Для нового города сразу создаём страницу — иначе он не появится в окне выбора города.
            if (!await db.PageCities.AnyAsync(p => p.CityId == editCity.Id))
            {
                db.PageCities.Add(NewPageFor(editCity));
                await db.SaveChangesAsync();
            }

            var id = editCity.Id;
            await LoadCitiesAsync(db);
            await SelectCityAsync(id);
            cityMessage = isNew ? "Город создан, страница города добавлена." : "Город сохранён.";
        }
        catch (Exception ex)
        {
            cityMessage = "Ошибка сохранения: " + ex.GetBaseException().Message; cityError = true;
        }
        finally
        {
            saving = false;
        }
    }

    private async Task SavePageAsync()
    {
        if (editCity is null || editCity.Id == 0 || editPage is null) return;
        ResetCityMessages();

        if (string.IsNullOrWhiteSpace(editPage.Title)) { pageMessage = "Укажите Title страницы."; pageError = true; return; }
        if (editPage.HeroTitle?.Length > 200 || editPage.LocalIntro?.Length > 1500 ||
            editPage.CoverageText?.Length > 1500 || editPage.PickupDetails?.Length > 1500)
        { pageMessage = "Превышена длина местного текста: H1 до 200, каждый блок до 1500 символов."; pageError = true; return; }
        if (editPage.Price is < 0 || editPage.PriceToKopeks is < 0) { pageMessage = "Цена не может быть отрицательной."; pageError = true; return; }

        saving = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            editPage.CityId = editCity.Id;
            editPage.PhoneCity = string.IsNullOrWhiteSpace(editPage.PhoneCity) ? null : editPage.PhoneCity.Trim();
            if (editPage.Id == 0) db.PageCities.Add(editPage);
            else db.PageCities.Update(editPage);
            await db.SaveChangesAsync();
            await LoadCitiesAsync(db);
            pageMessage = "Страница сохранена.";
        }
        catch (Exception ex)
        {
            pageMessage = "Ошибка сохранения: " + ex.GetBaseException().Message; pageError = true;
        }
        finally
        {
            saving = false;
        }
    }

    private async Task SavePromoAsync()
    {
        if (editCity is null || editCity.Id == 0 || editPromo is null) return;
        ResetCityMessages();

        if (editPromo.IsActive && (string.IsNullOrWhiteSpace(editPromo.Title) || string.IsNullOrWhiteSpace(editPromo.Text)))
        {
            promoMessage = "Для активного промо заполните заголовок и текст."; promoError = true;
            return;
        }

        saving = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            editPromo.CityId = editCity.Id;
            editPromo.Title = string.IsNullOrWhiteSpace(editPromo.Title) ? $"Акция в {editCity.NameIn}" : editPromo.Title.Trim();
            editPromo.Text ??= "";
            if (editPromo.Id == 0) db.PromoMessages.Add(editPromo);
            else db.PromoMessages.Update(editPromo);
            await db.SaveChangesAsync();
            promoMessage = "Промо сохранено.";
        }
        catch (Exception ex)
        {
            promoMessage = "Ошибка сохранения: " + ex.GetBaseException().Message; promoError = true;
        }
        finally
        {
            saving = false;
        }
    }

    // =====================================================================
    // MAIN PAGE — «Вся Беларусь»
    // =====================================================================

    private MainPageSettings mainPage = DbSeeder.CreateDefaultMainPage();
    private PromoMessage globalPromo = new() { Title = "Внимание!", Text = "", IsActive = false };
    private string? mainMessage; private bool mainError;
    private string? globalPromoMessage; private bool globalPromoError;

    private async Task LoadMainPageAsync(AppDBContext db)
    {
        mainPage = await db.MainPageSettings.AsNoTracking().OrderBy(s => s.Id).FirstOrDefaultAsync()
                   ?? DbSeeder.CreateDefaultMainPage();

        globalPromo = await db.PromoMessages.AsNoTracking().Where(p => p.CityId == null).OrderBy(p => p.Id).FirstOrDefaultAsync()
                      ?? new PromoMessage { Title = "Внимание!", Text = "", IsActive = false };
    }

    private RenderFragment MainPageTab() => __builder =>
    {
        <div class="admin-hint mb-3">
            <i class="fa-solid fa-circle-info"></i>
            Общая страница открывается по адресу <a href="/?all=1" target="_blank">ecobay.by/</a>, если посетитель не выбрал город.
            Здесь настраивается окно выбора города. Работаем только в активных городах и их районах, а не по всей Беларуси.
        </div>

        <div class="row g-3">
            <div class="col-lg-4">
                <div class="admin-card">
                    <h2 class="admin-card-title">SEO</h2>
                    <div class="mb-3">
                        <label class="admin-label">Title страницы</label>
                        <input class="form-control" @bind="mainPage.Title" maxlength="160" />
                    </div>
                    <div class="mb-3">
                        <label class="admin-label">Описание (meta description)</label>
                        <textarea class="form-control" rows="3" @bind="mainPage.Description" maxlength="300"></textarea>
                        <small class="admin-muted">Если пусто — сформируется автоматически по списку активных городов.</small>
                    </div>
                    <div class="mb-3">
                        <label class="admin-label">Ключевые слова</label>
                        <textarea class="form-control" rows="2" @bind="mainPage.KeyWords" maxlength="300"></textarea>
                    </div>

                    <h2 class="admin-card-title mt-4">Первый экран</h2>
                    <div class="mb-3">
                        <label class="admin-label">Заголовок (H1)</label>
                        <input class="form-control" @bind="mainPage.HeroTitle" maxlength="200" placeholder="Вывоз техники в наших городах и их районах" />
                    </div>
                    <div class="mb-3">
                        <label class="admin-label">Текст под заголовком</label>
                        <textarea class="form-control" rows="3" @bind="mainPage.HeroText" maxlength="600"
