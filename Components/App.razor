    <!-- Повторный визит: если пользователь уже выбирал город, сразу открываем его страницу
         (до загрузки остального, чтобы не было «мигания» общей страницы). -->
    <script>
        (function () {
            try {
                if (location.pathname !== "/" || /[?&](choose-city|all)=/.test(location.search)) return;
                var saved = localStorage.getItem("ecobay.city");
                var remember = localStorage.getItem("ecobay.city.remember") !== "0";
                if (remember && saved && saved !== "all" && /^[a-z0-9-]{1,50}$/.test(saved)) {
                    location.replace("/" + saved + location.hash);
                }
            } catch (e) { }
        })();
    </script>

