+@code {
+    [Parameter] public long CurrentUserId { get; set; }
+    [Parameter] public EventCallback<bool> OnClose { get; set; }
+
+    private sealed class Model
+    {
+        public string? Phone { get; set; }
+        public string? Name { get; set; }
+        public long? CityId { get; set; }
+        public string? Address { get; set; }
+        public string? Message { get; set; }
+    }
+
+    private readonly Model model = new();
+    private List<City> cities = new();
+    private IBrowserFile? file;
+    private string? previewUrl, ocrState, error;
+    private List<string> foundPhones = new();
+    private bool busy;
+    private DotNetObjectReference<AdminRequestCreate>? selfRef;
+
+    protected override async Task OnInitializedAsync()
+    {
+        await using var db = await DbFactory.CreateDbContextAsync();
+        cities = await db.Cities.AsNoTracking().Where(c => c.IsActive && c.Pages.Any())
+            .OrderBy(c => c.SortOrder).ThenBy(c => c.Name).ToListAsync();
+        if (cities.Count == 1) model.CityId = cities[0].Id;
+    }
+
+    private async Task OnFileAsync(InputFileChangeEventArgs e)
+    {
+        error = null;
+        foundPhones.Clear();
+        var f = e.File;
+        var invalid = RequestFileStore.Validate(f);
+        if (invalid is not null) { error = invalid; file = null; previewUrl = null; return; }
+        file = f;
+
+        try
+        {
+            // Предпросмотр — уменьшенная копия, чтобы не гонять 10 МБ через SignalR.
+            var preview = await f.RequestImageFileAsync("image/jpeg", 640, 640);
+            await using var s = preview.OpenReadStream(RequestFileStore.MaxBytes);
+            using var ms = new MemoryStream();
+            await s.CopyToAsync(ms);
+            previewUrl = "data:image/jpeg;base64," + Convert.ToBase64String(ms.ToArray());
+        }
+        catch (Exception ex)
+        {
+            Logger.LogWarning(ex, "Preview failed");
+            previewUrl = null;
+        }
+
+        // Распознавание текста — в браузере (Tesseract.js), сервер не нагружается.
+        ocrState = "Ищем номер телефона на скриншоте...";
+        StateHasChanged();
+        try
+        {
+            selfRef ??= DotNetObjectReference.Create(this);
+            await JS.InvokeVoidAsync("ecobayOcr.findPhones", "reqShot", selfRef);
+        }
+        catch (Exception ex)
+        {
+            Logger.LogWarning(ex, "OCR start failed");
+            ocrState = "Не удалось запустить распознавание. Введите телефон вручную.";
+        }
+    }
+
+    [JSInvokable]
+    public Task OnPhonesFound(string[] phones, string? errorText)
+    {
+        foundPhones = phones?.Distinct().Take(5).ToList() ?? new();
+        if (errorText is not null)
+            ocrState = "Не удалось распознать текст. Введите телефон вручную.";
+        else if (foundPhones.Count == 0)
+            ocrState = "Номер на скриншоте не найден. Введите его вручную.";
+        else
+        {
+            if (string.IsNullOrWhiteSpace(model.Phone)) model.Phone = foundPhones[0];
+            ocrState = foundPhones.Count == 1
+                ? $"Найден номер {foundPhones[0]} — проверьте его."
+                : "Найдено несколько номеров — выберите нужный.";
+        }
+        return InvokeAsync(StateHasChanged);
+    }
+
+    private void RemoveFile()
+    {
+        file = null;
+        previewUrl = null;
+        ocrState = null;
+        foundPhones.Clear();
+    }
+
+    private async Task SaveAsync()
+    {
+        if (busy) return;
+        error = null;
+        var phone = PhoneUtil.Normalize(model.Phone);
+        if (!PhoneUtil.IsValid(phone)) { error = "Укажите телефон (9–15 цифр)."; return; }
+        if (model.CityId is null) { error = "Выберите город."; return; }
+
+        busy = true;
+        try
+        {
+            await using var db = await DbFactory.CreateDbContextAsync();
+            var page = await db.PageCities.AsNoTracking().Where(p => p.CityId == model.CityId).OrderBy(p => p.Id).FirstOrDefaultAsync();
+            if (page is null) { error = "У выбранного города нет страницы. Сохраните город во вкладке «Города»."; return; }
+
+            var last9 = PhoneUtil.Last9(phone);
+            var client = await db.Clients.FirstOrDefaultAsync(c => c.Phone.EndsWith(last9));
+            if (client is null)
+            {
+                client = new Client { Name = model.Name?.Trim() ?? "", Phone = phone, CityId = model.CityId };
+                db.Clients.Add(client);
+            }
+            else
+            {
+                if (!string.IsNullOrWhiteSpace(model.Name)) client.Name = model.Name.Trim();
+                client.CityId ??= model.CityId;
+            }
+            await db.SaveChangesAsync();
+
+            string? shot = null;
+            if (file is not null) shot = await Files.SaveAsync(file);
+
+            db.Requests.Add(new Request
+            {
+                ClientId = client.Id,
+                PageCityId = page.Id,
+                DateCreate = DateTime.Now,
+                Message = string.IsNullOrWhiteSpace(model.Message) ? null : model.Message.Trim(),
+                Address = string.IsNullOrWhiteSpace(model.Address) ? null : model.Address.Trim(),
+                Source = "admin:manual",
+                IsManual = true,
+                CreatedByUserId = CurrentUserId,
+                ScreenshotPath = shot
+            });
+            await db.SaveChangesAsync();
+
+            // Как и заявка с сайта, ручная заявка увеличивает факт активной цели.
+            var year = DateTime.Now.Year;
+            await db.Goals.Where(g => g.IsActive && g.Year == year)
+                .ExecuteUpdateAsync(u => u
+                    .SetProperty(g => g.ActualClients, g => g.ActualClients + 1)
+                    .SetProperty(g => g.ActualItems, g => g.ActualItems + 1));
+        }
+        catch (Exception ex)
+        {
+            Logger.LogError(ex, "Cannot create manual request");
+            error = "Не удалось сохранить заявку. Повторите попытку.";
+            return;
+        }
+        finally { busy = false; }
+
+        await OnClose.InvokeAsync(true);
+    }
+
+    public void Dispose() => selfRef?.Dispose();
+}
