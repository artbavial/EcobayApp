+@using EcobayApp.Contex
+@using EcobayApp.Models
+@using EcobayApp.Services
+@using Microsoft.EntityFrameworkCore
+@implements IDisposable
+@inject IDbContextFactory<AppDBContext> DbFactory
+@inject RequestFileStore Files
+@inject IJSRuntime JS
+@inject ILogger<AdminRequestCreate> Logger
+
+<div class="admin-card mb-3 req-create">
+    <div class="d-flex justify-content-between align-items-center mb-3">
+        <h2 class="admin-card-title mb-0">Новая заявка вручную</h2>
+        <button class="btn btn-outline-secondary btn-sm" disabled="@busy" @onclick="() => OnClose.InvokeAsync(false)">Закрыть</button>
+    </div>
+
+    <div class="row g-3">
+        <div class="col-lg-5">
+            <label class="admin-label" for="reqShot">Скриншот (необязательно)</label>
+            <div class="req-dropzone @(previewUrl is null ? "" : "has-file")">
+                <InputFile id="reqShot" accept="image/png,image/jpeg,image/webp" OnChange="OnFileAsync" disabled="@busy" />
+                @if (previewUrl is null)
+                {
+                    <div class="req-dropzone-hint">
+                        <i class="fa-solid fa-image"></i>
+                        <span>Выберите или перетащите скриншот переписки/звонка</span>
+                        <small>PNG, JPG, WEBP до 10 МБ. Телефон со скриншота подставится автоматически.</small>
+                    </div>
+                }
+                else
+                {
+                    <img src="@previewUrl" alt="Предпросмотр скриншота" />
+                }
+            </div>
+            @if (ocrState is not null) { <p class="admin-muted mt-2 mb-0">@ocrState</p> }
+            @if (foundPhones.Count > 1)
+            {
+                <div class="req-phone-chips">
+                    <span class="admin-muted">Найдено несколько номеров:</span>
+                    @foreach (var p in foundPhones)
+                    {
+                        <button type="button" class="btn btn-sm @(model.Phone == p ? "btn-success" : "btn-outline-success")" @onclick="() => model.Phone = p">@p</button>
+                    }
+                </div>
+            }
+            @if (file is not null)
+            {
+                <button class="btn btn-link btn-sm px-0" disabled="@busy" @onclick="RemoveFile">Убрать скриншот</button>
+            }
+        </div>
+
+        <div class="col-lg-7">
+            <div class="row g-2">
+                <div class="col-sm-6">
+                    <label class="admin-label" for="reqPhone">Телефон *</label>
+                    <input id="reqPhone" class="form-control" inputmode="tel" @bind="model.Phone" placeholder="+375 29 123-45-67" disabled="@busy" />
+                </div>
+                <div class="col-sm-6">
+                    <label class="admin-label" for="reqName">Имя</label>
+                    <input id="reqName" class="form-control" maxlength="100" @bind="model.Name" disabled="@busy" />
+                </div>
+                <div class="col-sm-6">
+                    <label class="admin-label" for="reqCity">Город *</label>
+                    <select id="reqCity" class="form-select" @bind="model.CityId" disabled="@busy">
+                        <option value="">Выберите город</option>
+                        @foreach (var c in cities) { <option value="@c.Id">@c.Name</option> }
+                    </select>
+                </div>
+                <div class="col-sm-6">
