+		[MaxLength(1000)]
+		public string? Comment { get; set; }
+
+		public decimal? PaidAmount { get; set; }
+
+		public long? UserId { get; set; }
+
+		[MaxLength(100)]
+		public string? UserName { get; set; }
+
+		public DateTime CreatedAt { get; set; } = DateTime.Now;
+	}
+}
